        ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_62,
        ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_88 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "On Language"^^xsd:string ;
    neo:id "333b031f6416a435f34756f4550bd489"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "We work within the limits of language to describe the process of clear seeing that is at times difficult to pin down with words. As such, some rules of grammar may be bent a teeny bit. A construct like \"the mind is knowing\" instead of \"the mind knows\" is used in instances where it seems more appropriate to describe something in process. The following words are used interchangeably: watching, being aware, observing, being mindful, recognizing, noticing, and paying attention. You may also see the word \"yogi\" used often, which is Sayadaw's reference to a meditator. \"Dhamma\" with a big \"D\" refers to the teachings of the Buddha and the practice of meditation while \"dhamma\" with a little \"d\" refers to natural phenomena, natural law, or object."^^xsd:string .

ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_17 a neo:Document ;
    neo:MENTIONS ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_16,
        ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_18 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Introduction (ghost chapter)"^^xsd:string ;
    neo:h3 "COLLECTING GOLD DUST"^^xsd:string ;
    neo:id "dd488745edba827d259c5f8fe17a1408"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 7 ;
    neo:text "play with awareness"^^xsd:string .

ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_181 a neo:Document ;
    neo:MENTIONS ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_18,
        ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_182,
        ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_183,
        ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_184,
        ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_185,
        ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_56,
        ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_69 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "On Language"^^xsd:string ;
    neo:id "25f9fb04773e9ecae76f2f433f9d290e"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "We have tried to maintain Sayadaw's voice as much as possible throughout. The combination word \"awareness + wisdom,\" first coined by Sayadaw, but used freely before the book Dhamma Everywhere came out, underscores the need for more than mere awareness in vipassana (insight) meditation. Sayadaw always maintained that his teacher, the late Shwe Oo Min Sayadaw, referred to awareness with the assumption of inherent wisdom."^^xsd:string .

ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_186 a neo:Document ;
    neo:MENTIONS ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_187,
        ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_188 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "On Language"^^xsd:string ;
    neo:id "4bacb0e94f916583e356520fadcac1ab"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:text "We have also used the singular \"they\" as a gender-neutral pronoun where possible."^^xsd:string .

ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_189 a neo:Document ;
    neo:MENTIONS ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_190,
        ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_191,
        ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_47 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "On Language"^^xsd:string ;
    neo:id "1ac5881cf60f8e29c1e0e32e6e5072ad"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:text "Pali and English words have been used throughout the book although we have limited Pali usage to make this daily life book as accessible as possible."^^xsd:string .

ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_19 a neo:Document ;
