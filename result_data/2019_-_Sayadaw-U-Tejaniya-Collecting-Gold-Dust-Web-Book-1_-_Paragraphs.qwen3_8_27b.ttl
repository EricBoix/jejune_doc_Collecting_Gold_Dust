    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "My teacher constantly reminded me that all the problems in the world originate from the trio of lobha, dosa, and moha. Keep an eye on them. Watching and keeping these unwholesome qualities at bay will allow the wholesome qualities to arise automatically."^^xsd:string .

ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_66 a neo:Document ;
    neo:MENTIONS ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_39,
