        ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_739,
        ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_740,
        ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_741 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Take a Closer Look"^^xsd:string ;
    neo:h3 "DELUSION"^^xsd:string ;
    neo:id "5d09ed397a238ecfec4ad1ff8e627d73"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "Moha is darkness and you have a thief's tiny flashlight. When you turn it on, it will light up a small area in front of you and you're probably satisfied with that. You may think, \"Oh, I know a lot now.\" What about everything that you do not notice? It's vast and you only know what you know, but you do not know what you do not know."^^xsd:string .

ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_742 a neo:Document ;
    neo:MENTIONS ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_15,
        ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_18,
        ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_518,
