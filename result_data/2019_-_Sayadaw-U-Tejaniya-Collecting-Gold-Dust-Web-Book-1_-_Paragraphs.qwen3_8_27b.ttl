    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "When you are aware of what's happening in the mind, you begin to notice the undesirable parts and will want to change. This is a beginning. The lessons are all there for you to go through and learn. Later on, if you really come to understand that something that is wrong is wrong, you will not repeat it again."^^xsd:string .

ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_898 a neo:Document ;
