    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:text "Finally, I would like to thank everyone who has contributed to the completion of this book. Sayadaw U Tejaniya"^^xsd:string .

