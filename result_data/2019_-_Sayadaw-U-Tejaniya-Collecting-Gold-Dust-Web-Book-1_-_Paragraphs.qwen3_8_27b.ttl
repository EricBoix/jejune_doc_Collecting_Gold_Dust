        ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_752,
        ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_988,
        ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_989 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:h3 "SPEAKING MINDFULLY"^^xsd:string ;
    neo:id "ee60255f9ed2c8d5eac0af8af0665deb"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "We must be aware of ourselves every time we speak; come to know the many steps the mind goes through to speak. If yogis make a habit of knowing themselves, then awareness when speaking will naturally become part of that habit."^^xsd:string .

ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_990 a neo:Document ;
    neo:MENTIONS ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_18,
