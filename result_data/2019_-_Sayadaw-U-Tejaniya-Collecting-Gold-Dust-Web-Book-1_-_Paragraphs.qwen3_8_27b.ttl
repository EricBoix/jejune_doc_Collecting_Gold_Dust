        ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_74 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Dear Reader"^^xsd:string ;
    neo:id "c15e4faff4f218a933df66f93dac4dec"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:text "Sayadaw often encourages yogis to continue cultivating their own energy and wisdom after a retreat. To help post-retreat, some of Sayadaw's retreats even have participants going mindfully about their business during the day in their own homes or workplaces and discussing their eperiences and discoveries in evening and weekend Q&A sessions. Other retreats have incorporated mindful talking periods during the day."^^xsd:string .

ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_660 a neo:Document ;
    neo:MENTIONS ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_110,
        ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_18,
        ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_339,
        ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_54,
        ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_619,
        ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_661 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Take a Closer Look"^^xsd:string ;
    neo:h3 "THE SPECTRUM OF WANTING"^^xsd:string ;
    neo:id "1882a0a9132bbd6f2e055189b05427e1"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "When there are lots of pleasant physical sensations, we may become greedy for more. Watch this greed while continuing to keep an eye on awareness as much as possible. When the wanting is very subtle and not detectable, you are at least still able to recognize the presence of awareness. With an awareness of awareness, it is harder for the mind to get lost in the pleasant sensations. Additionally, having to work at being continuously aware makes it harder for greed to wallow in the feeling."^^xsd:string .

ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_662 a neo:Document ;
    neo:MENTIONS ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_223,
        ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_501,
        ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_527,
        ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_54,
        ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_663,
        ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_664,
        ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_665,
        ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_666,
