        ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_545,
        ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_652 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Reflect. Learn. Keep Going."^^xsd:string ;
    neo:h3 "REVIEWING WHAT HAS HAPPENED"^^xsd:string ;
    neo:id "88298ff5d46d0c0c958231ae4d2cf279"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "My teacher would always ask how I was practicing and that is what I'm asking you now. \"What are you doing?\" or \"What is special or different today?\" were questions my teacher would ask me. Yogis who are practicing will know the answer while those who are not practicing will not know."^^xsd:string .

