    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Take a Closer Look"^^xsd:string ;
    neo:h3 "GOING THROUGH ROADBLOCKS"^^xsd:string ;
    neo:id "b8edd10043b8830f2b8a2ac482a788d6"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:text "We should be interested in the relationships within us: the interplay of objects, the state of mind, wisdom, defilements, and awareness. These are the relationships that we want to take care of. People out there and what they are doing are concepts. Moreover, objects out there are not doing anything but minding their own business. But this mind is not minding its own business and getting into all sorts of trouble. This is the relationship we want to take care of and this is what the practice is all about."^^xsd:string .

ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_771 a neo:Document ;
