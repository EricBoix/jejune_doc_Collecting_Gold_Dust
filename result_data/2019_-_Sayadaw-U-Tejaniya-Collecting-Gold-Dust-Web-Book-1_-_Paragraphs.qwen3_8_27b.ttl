        ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_956 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:h3 "CAUSES AND CONDITIONS"^^xsd:string ;
    neo:id "d041ac763d934e47f83079cd06b335ae"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:text "If you stay in the present moment, moment to moment to moment, you see the principles unfold. If you are angry and you watch that anger many times, you will begin to notice how the anger cannot run away with you as long as you are aware. You begin to see how, with awareness + wisdom, the unwholesome mental states cannot take over the mind."^^xsd:string .

ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_957 a neo:Document ;
    neo:MENTIONS ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_18,
