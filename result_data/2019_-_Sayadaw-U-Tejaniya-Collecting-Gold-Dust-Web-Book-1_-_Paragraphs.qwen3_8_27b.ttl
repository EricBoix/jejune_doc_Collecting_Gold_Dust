        ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_964,
        ex:node_4_2970e5b0_c019_4056_86a0_f3b0ab208a9b_965 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:h3 "CAUSES AND CONDITIONS"^^xsd:string ;
    neo:id "508c1dc850332a6b55e1039536627e80"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:text "I say this a lot: when yogis successfully observe something unwholesome and it passes, and they are happy. But that's not the end. It is important to reflect at that point what would have happened if we had not been mindful. If we are just happy in la la land we don't get to learn what it is like to be unmindful."^^xsd:string .

