    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 7 ;
    neo:text "play with awareness"^^xsd:string .

ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_151 a neo:Document ;
    neo:MENTIONS ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_152,
        ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_153 ;
