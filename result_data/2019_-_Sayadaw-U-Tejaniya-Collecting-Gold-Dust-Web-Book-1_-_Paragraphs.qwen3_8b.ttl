ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_154 a neo:Document ;
    neo:MENTIONS ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_155,
        ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_156,
        ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_157 ;
