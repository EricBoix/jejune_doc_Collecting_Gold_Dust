        ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_763,
        ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_764,
        ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_765 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:id "a8474f47efeac6161c55ce80c00f1db4"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:text "This is what my teacher, Shwe Oo Min Sayadaw would say as his instructions. In the first two lines, he is speaking to the experience of what is happening. Awareness can be at work, but you do not try to alter the experience. You let the process continue as it is without interfering. Let things unfold naturally. Your job is to watch, know, learn, and gain experience. As you watch an experience continuously, you'll begin to recognize patterns within it and later see the whole picture. The value of this meditation becomes more apparent with dedicated practice over long stretches of time. The more experienced you become, the deeper you will see. The dhamma is very subtle and you'll see this when you practice long term."^^xsd:string .

ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_766 a neo:Document ;
    neo:MENTIONS ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_171,
        ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_290,
        ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_441,
        ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_642,
        ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_767,
        ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_768,
        ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_82,
        ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_83,
        ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_84 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:id "a342c4f01ae4f5964382955c3227afcb"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:text "What is happening in the mind and what is happening in the body right now? How is one mind or mental state related to another mental state? You want to be interested in the nature of this mind and body. Hold concepts or story lines on the side for now. As wisdom gains traction and defilements eventually thin out, you'll see that there aren't that many problems per se. \"Problems\" arise when there is a lot of greed, aversion or delusion present. When we can't accept things as they are, we exhaust ourselves with desire for things that are not present or with desire to push away things that are already there."^^xsd:string .

