        ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_171,
        ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_27,
        ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_360 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Continuing the Work"^^xsd:string ;
    neo:h3 "GATHERING MOMENTUM, COLLECTING GOLD DUST"^^xsd:string ;
    neo:id "030717352fd3b88aa7c334a840a6d2c1"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 8 ;
    neo:text "The real benefit of the Dhamma is not to stop engaging with life issues but to approach the same tasks with wisdom instead of defilements, having understood how they work."^^xsd:string .

ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_1283 a neo:Document ;
