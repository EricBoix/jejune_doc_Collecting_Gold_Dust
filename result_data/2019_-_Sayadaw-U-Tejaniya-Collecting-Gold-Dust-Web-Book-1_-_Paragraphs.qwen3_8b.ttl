    neo:id "Allowing Overthinking To Continue"^^xsd:string ;
    neo:llm_model_name "qwen3:8b"^^xsd:string .

ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_994 a neo:Document ;
    neo:MENTIONS ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_290,
        ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_725,
        ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_995,
        ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_996,
        ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_997 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:h3 "THINKING PROCESSES"^^xsd:string ;
    neo:id "4c8c3114575b39d9b379644f51b308c8"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:text "When there are strong wholesome qualities in the mind, it is difficult for the mind to suddenly change and become unwholesome; when there is a strong unwholesome train of thought going on, it's difficult for it to suddenly switch and become wholesome. I experimented for myself when my mind was wholesome. I tried to intentionally think negative thoughts and realized that I could not."^^xsd:string .

