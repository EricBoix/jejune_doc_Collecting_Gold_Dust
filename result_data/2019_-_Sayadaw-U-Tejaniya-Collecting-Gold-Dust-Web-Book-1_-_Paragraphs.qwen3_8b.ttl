ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_74 a neo:Document ;
    neo:MENTIONS ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_41,
        ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_75,
