ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_146 a neo:Document ;
    neo:MENTIONS ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_147,
        ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_148,
        ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_149,
        ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_150,
        ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_41 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "On Language"^^xsd:string ;
    neo:id "25f9fb04773e9ecae76f2f433f9d290e"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "We have tried to maintain Sayadaw's voice as much as possible throughout. The combination word \"awareness + wisdom,\" first coined by Sayadaw, but used freely before the book Dhamma Everywhere came out, underscores the need for more than mere awareness in vipassana (insight) meditation. Sayadaw always maintained that his teacher, the late Shwe Oo Min Sayadaw, referred to awareness with the assumption of inherent wisdom."^^xsd:string .

ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_15 a neo:Document ;
