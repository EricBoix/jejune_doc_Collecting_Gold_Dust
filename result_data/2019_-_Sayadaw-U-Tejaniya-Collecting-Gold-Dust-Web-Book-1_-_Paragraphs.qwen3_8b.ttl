    neo:h2 "Appendix: Mindfulness in Brief"^^xsd:string ;
    neo:id "2843b00c5acc5403628b1a851e53ec55"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 27 ;
    neo:text "If you are strongly attached to ideas, there will be triggers when someone else presents a conflicting idea."^^xsd:string .

ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_1404 a neo:Document ;
    neo:MENTIONS ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_1405,
        ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_1406,
        ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_1407,
        ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_1408,
        ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_1409,
        ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_1410,
        ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_1411,
        ex:node_4_037c2398_17b8_4f53_9503_29faec04f111_195 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Appendix: Mindfulness in Brief"^^xsd:string ;
    neo:id "bb6359a98e2c85f873e0c606f6359b38"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 28 ;
    neo:text "Be a little extra careful at home. It is so much more interesting at home when mindfulness is always present, and especially when we bring mindfulness to daily life situations. In your talking to others you learn to see others' intentions and learn to speak in a way that helps you to manage yourself and manage the conversation as well. We begin to know what we are going to say before we say it and eventually have time to choose the skillful path."^^xsd:string .

