    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:sentence_number 1 ;
    neo:text "If you stay in the present moment, moment to moment to moment, you see the principles unfold."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2372 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_1401,
