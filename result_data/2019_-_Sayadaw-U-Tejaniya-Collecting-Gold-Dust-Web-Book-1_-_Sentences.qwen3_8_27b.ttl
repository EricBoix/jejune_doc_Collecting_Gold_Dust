    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 14 ;
    neo:sentence_number 10 ;
    neo:text "I was sure the policeman on the street knew about all my misbehaviors."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_607 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_43,
