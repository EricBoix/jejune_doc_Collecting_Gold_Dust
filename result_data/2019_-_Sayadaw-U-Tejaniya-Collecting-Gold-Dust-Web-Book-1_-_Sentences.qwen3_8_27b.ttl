        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_84,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_97 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "2b976cfe463f642151e4b25f40000819"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 14 ;
    neo:sentence_number 7 ;
    neo:text "Ironically it was right on the way home in the taxi from that retreat that I actually descended into the deepest depression of my life."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_598 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_426,
