    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:sentence_number 4 ;
    neo:text "Whenever awareness is established and strong, and we have an insight, we will begin to see nature in ways that we had never conceived of before and see things in ways we had never seen before."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_438 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_439,
