    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 7 ;
    neo:sentence_number 2 ;
    neo:text "Sometimes we miss the fact that it is there and doing its work because we are not familiar with the nature of wisdom and its various job descriptions."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_445 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_153,
