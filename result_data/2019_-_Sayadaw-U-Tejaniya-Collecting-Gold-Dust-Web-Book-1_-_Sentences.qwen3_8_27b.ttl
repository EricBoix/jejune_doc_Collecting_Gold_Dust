        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_526,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_527 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "313fb971789876f7a883dcf40b86f264"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 10 ;
    neo:sentence_number 4 ;
    neo:text "I recalled my teacher's words the next morning as I was brushing my teeth and when I posed the question, it felt like a weight was suddenly taken off my mind."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_528 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_124,
