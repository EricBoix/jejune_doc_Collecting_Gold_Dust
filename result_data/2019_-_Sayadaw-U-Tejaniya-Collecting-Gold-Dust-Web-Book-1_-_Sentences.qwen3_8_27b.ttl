    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 14 ;
    neo:sentence_number 11 ;
    neo:text "I went home fearful."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_609 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_26,
