    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 20 ;
    neo:sentence_number 2 ;
    neo:text "I often felt unable to make the decisions that had to be made."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_760 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_43,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_685,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_759,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_761,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_762 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "2eb7b2ca9ef31b52b98f5340471958ad"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 20 ;
    neo:sentence_number 3 ;
    neo:text "Very often, the decisions just had to be made, without regard as to whether they were right or wrong, because my state of mind did not allow me this perspective."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_763 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_43,
