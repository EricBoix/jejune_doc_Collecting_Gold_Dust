    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:sentence_number 4 ;
    neo:text "We can do one of these things: we can remember that the objects are just nature, or that the objects are just things that are being known."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3460 a neo:Document ;
