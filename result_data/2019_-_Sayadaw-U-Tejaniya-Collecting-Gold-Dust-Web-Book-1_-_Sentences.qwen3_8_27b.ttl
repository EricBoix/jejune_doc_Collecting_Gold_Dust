    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:sentence_number 4 ;
    neo:text "In English, I like to use words like awareness, mindfulness, remembering, not forgetting, recognizing, and noticing for the Pali word of sati."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3470 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2097,
