    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 19 ;
    neo:sentence_number 3 ;
    neo:text "He would tell me it takes time to find our footing and encouraged me to keep trying."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_737 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_738,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_739 ;
