    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 14 ;
    neo:sentence_number 12 ;
    neo:text "This time I could not shake the feelings that overtook me and it was two long years of depression at home before I finally turned in desperation to meditation again, but this time I did not go to the monastery."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_610 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_611 ;
