    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 8 ;
    neo:sentence_number 4 ;
    neo:text "Being aware of only the conceptual part of the experience is not sati."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3497 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3491,
