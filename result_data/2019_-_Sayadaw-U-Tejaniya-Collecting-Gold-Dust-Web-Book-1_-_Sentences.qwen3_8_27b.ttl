    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 25 ;
    neo:sentence_number 1 ;
    neo:text "Finally, let's discuss talking."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3662 a neo:Document ;
