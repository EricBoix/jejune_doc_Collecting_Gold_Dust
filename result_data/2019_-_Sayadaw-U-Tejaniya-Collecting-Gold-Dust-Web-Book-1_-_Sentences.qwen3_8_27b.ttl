    neo:paragraph_number 20 ;
    neo:sentence_number 7 ;
    neo:text "The Vicks inhaler is a small tube with some mentholated ointment or oil inside that one can inhale through the tube."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_775 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_353,
