    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 21 ;
    neo:sentence_number 1 ;
    neo:text "During these initial two months I also began reading the books of Mogok Sayadaw."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_782 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_43,
