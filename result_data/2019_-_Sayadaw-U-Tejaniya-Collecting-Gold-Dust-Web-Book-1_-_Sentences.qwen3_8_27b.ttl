        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_501 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:id "3ff2460ab186b32e06de37ad2454f950"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:sentence_number 7 ;
    neo:text "When we can't accept things as they are, we exhaust ourselves with desire for things that are not present or with desire to push away things that are already there."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2288 a neo:Document ;
