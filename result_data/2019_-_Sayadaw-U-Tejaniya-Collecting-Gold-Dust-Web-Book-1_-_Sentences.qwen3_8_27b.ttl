    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 23 ;
    neo:sentence_number 1 ;
    neo:text "The goal of Satipatthana practice is to understand deeply."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3645 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_1441,
