    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 25 ;
    neo:sentence_number 6 ;
    neo:text "Then you will also know if there is a need to talk."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_367 a neo:Document ;
