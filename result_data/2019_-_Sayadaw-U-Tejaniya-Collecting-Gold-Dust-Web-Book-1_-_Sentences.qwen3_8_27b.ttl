    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 8 ;
    neo:sentence_number 1 ;
    neo:text "For example, if I am sitting on a rug right now and I'm aware of this rug, this is not considered meditation awareness."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3492 a neo:Document ;
