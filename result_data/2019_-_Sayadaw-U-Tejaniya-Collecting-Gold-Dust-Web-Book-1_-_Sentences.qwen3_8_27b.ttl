    neo:paragraph_number 5 ;
    neo:sentence_number 2 ;
    neo:text "I experimented for myself when my mind was wholesome."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2706 a neo:Document ;
