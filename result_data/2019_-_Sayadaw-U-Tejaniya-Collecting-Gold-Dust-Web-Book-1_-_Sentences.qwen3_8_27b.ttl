    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:sentence_number 2 ;
    neo:text "We then cultivate the other four faculties through continuous mindfulness."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3465 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_1203,
