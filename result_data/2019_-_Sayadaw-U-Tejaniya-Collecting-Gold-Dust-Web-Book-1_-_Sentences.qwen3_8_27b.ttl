    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 19 ;
    neo:sentence_number 10 ;
    neo:text "The simplest answer is that your leg hurts because you have a leg."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3604 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_1203,
