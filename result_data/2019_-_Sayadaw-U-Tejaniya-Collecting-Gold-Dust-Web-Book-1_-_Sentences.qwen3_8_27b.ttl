    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 4 ;
    neo:text "You will experience when it has become too much and having this experience will allow you to learn from overthinking."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2703 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_1559,
