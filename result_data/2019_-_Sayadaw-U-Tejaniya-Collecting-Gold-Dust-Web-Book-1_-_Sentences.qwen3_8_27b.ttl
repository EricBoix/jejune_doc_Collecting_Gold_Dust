    neo:paragraph_number 6 ;
    neo:sentence_number 3 ;
    neo:text "When Dhamma-related thinking has to do with your actual practice, it's probably helpful."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2714 a neo:Document ;
