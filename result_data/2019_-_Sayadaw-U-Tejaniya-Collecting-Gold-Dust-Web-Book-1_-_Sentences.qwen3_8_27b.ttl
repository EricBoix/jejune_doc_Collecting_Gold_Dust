    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "9018c861d91596afed1d5c573de0726c"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 19 ;
    neo:sentence_number 4 ;
    neo:text "My problem was not one of ability to practice."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_740 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_26,
