    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:sentence_number 1 ;
    neo:text "When we meditate, any phenomenon or experience that is being known becomes an object."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3455 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_153,
