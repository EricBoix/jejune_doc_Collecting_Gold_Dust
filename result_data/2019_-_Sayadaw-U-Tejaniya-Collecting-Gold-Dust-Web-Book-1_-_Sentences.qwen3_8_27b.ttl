    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 7 ;
    neo:sentence_number 8 ;
    neo:text "We react negatively as a result and try to do something immediately to fix the experience rather than seeing it as it is and checking it out."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_46 a neo:Document ;
