    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 10 ;
    neo:sentence_number 6 ;
    neo:text "It took off!"^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_532 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_20,
