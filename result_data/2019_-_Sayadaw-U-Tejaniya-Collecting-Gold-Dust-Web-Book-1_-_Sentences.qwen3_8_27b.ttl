    neo:paragraph_number 23 ;
    neo:sentence_number 3 ;
    neo:text "This calm state is a by-product of understanding or insight."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3650 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_1877,
