    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 1 ;
    neo:text "We work within the limits of language to describe the process of clear seeing that is at times difficult to pin down with words."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2710 a neo:Document ;
