    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 6 ;
    neo:text "That's why the Buddha said to practice continuously."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2820 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_20,
