        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_744,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_745,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_746 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
