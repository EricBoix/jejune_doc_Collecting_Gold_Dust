    neo:paragraph_number 26 ;
    neo:sentence_number 9 ;
    neo:text "Whenever we say something wrong, we will suffer a little bit but if mindfulness stays with us, we will always learn."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3694 a neo:Document ;
