    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 19 ;
    neo:sentence_number 7 ;
    neo:text "I didn't want to suffer and the temporary peace I got did not satisfy the mind's craving."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_750 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_43,
