    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:sentence_number 3 ;
    neo:text "Although we may not always realize it, just persevering and noticing is the main skill we need."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_437 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_18,
