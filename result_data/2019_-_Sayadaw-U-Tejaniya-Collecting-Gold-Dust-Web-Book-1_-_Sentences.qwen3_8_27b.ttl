    neo:paragraph_number 6 ;
    neo:sentence_number 1 ;
    neo:text "Know that not all Dhamma-related thinking will necessarily be wholesome."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_271 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_272,
