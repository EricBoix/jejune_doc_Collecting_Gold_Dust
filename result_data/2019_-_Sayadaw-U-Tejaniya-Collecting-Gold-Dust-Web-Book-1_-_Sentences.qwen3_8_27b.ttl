    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:sentence_number 6 ;
    neo:text "If, on the other hand, it is wholesome, we can encourage it."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2698 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_1829,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_422 ;
