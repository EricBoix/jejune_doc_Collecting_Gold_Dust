    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 24 ;
    neo:sentence_number 2 ;
    neo:text "Please be patient."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3655 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2551,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_353,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3656,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_496 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Appendix: Mindfulness in Brief"^^xsd:string ;
    neo:id "1d23860fcd93065485cd7fb79f454712"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 24 ;
    neo:sentence_number 3 ;
    neo:text "When there is pain, watch the resistance in the mind and do this only for as long as it is bearable."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3657 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_183,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_184,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3521,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3658,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_535 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Appendix: Mindfulness in Brief"^^xsd:string ;
    neo:id "83c21ae5b7eb38429496517d644c9f44"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 24 ;
    neo:sentence_number 4 ;
    neo:text "When you change your posture, be aware of two possible motivations behind it: 1) greed to be more comfortable, or 2) understanding that if you continue to sit in that position, your aversion will grow."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3659 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_183,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_184 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Appendix: Mindfulness in Brief"^^xsd:string ;
    neo:id "184ba63a252a05e44340f8eff14d3c06"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 24 ;
    neo:sentence_number 5 ;
    neo:text "You don't want to be growing aversion any more than you want to be growing greed."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3660 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_1037,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_184,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3658,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_496 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Appendix: Mindfulness in Brief"^^xsd:string ;
    neo:id "245249209a250f48644d6510d4f3402f"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 24 ;
    neo:sentence_number 6 ;
    neo:text "Understanding that the pain might become too much, you let go of the pain and make yourself more comfortable to prevent the growth of aversion."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3661 a neo:Document ;
