    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:sentence_number 5 ;
    neo:text "As wisdom gains traction and defilements eventually thin out, you'll see that there aren't that many problems per se."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2281 a neo:Document ;
