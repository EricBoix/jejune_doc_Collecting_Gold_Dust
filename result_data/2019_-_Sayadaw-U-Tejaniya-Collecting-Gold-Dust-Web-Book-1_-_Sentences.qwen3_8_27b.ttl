    neo:sentence_number 6 ;
    neo:text "If it is very practiced then the knowing happens naturally."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_281 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_128,
