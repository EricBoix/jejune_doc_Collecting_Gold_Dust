        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_756,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_757 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "19a7394cc9d39c6186fbf16decfaff38"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 20 ;
    neo:sentence_number 1 ;
    neo:text "I worked at my father's shop, trying to cope with the demands of the business in my state of anxiety, uncertainty, and fear."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_758 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_43,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_759 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
