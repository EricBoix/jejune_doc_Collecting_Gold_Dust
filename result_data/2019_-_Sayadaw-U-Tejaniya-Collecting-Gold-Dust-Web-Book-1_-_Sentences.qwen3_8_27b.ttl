    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 16 ;
    neo:sentence_number 7 ;
    neo:text "Then it dawned on me after he left that I was all alone in that area."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_664 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_665,
