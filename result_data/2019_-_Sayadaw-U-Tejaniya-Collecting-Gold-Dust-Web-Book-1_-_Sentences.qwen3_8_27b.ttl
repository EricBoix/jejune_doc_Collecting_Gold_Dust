    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 23 ;
    neo:sentence_number 4 ;
    neo:text "The real goal of this meditation is to understand."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3651 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_1037,
