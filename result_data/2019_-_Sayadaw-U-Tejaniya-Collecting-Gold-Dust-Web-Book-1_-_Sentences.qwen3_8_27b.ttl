    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 19 ;
    neo:sentence_number 6 ;
    neo:text "I already benefited from keeping up the mindfulness--it did give me relief from the suffering--but it did not give a lasting peace, which I craved."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_747 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_353,
