    neo:sentence_number 4 ;
    neo:text "These are all a part of our experience."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3590 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_119,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_184,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2068,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_223,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_344,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_353,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3591 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Appendix: Mindfulness in Brief"^^xsd:string ;
    neo:id "327aaa9404e1a806ed940416b8265767"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 19 ;
    neo:sentence_number 3 ;
    neo:text "If the mind is feeling uncomfortable, adjust the attitude, remind yourself that this is nature and then, having brought in the right view, watch the discomfort or the aversion in the mind."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3592 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2551,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3593 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Appendix: Mindfulness in Brief"^^xsd:string ;
    neo:id "7981154a3dc60a6c7b76dc729c1ab90e"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 19 ;
    neo:sentence_number 4 ;
    neo:text "First, watch the resistance and then you can watch the actual physical sensations."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3594 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_15,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_496 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Appendix: Mindfulness in Brief"^^xsd:string ;
    neo:id "ff139da7c7ee40da36f0091bc7ae7cb7"^^xsd:string ;
