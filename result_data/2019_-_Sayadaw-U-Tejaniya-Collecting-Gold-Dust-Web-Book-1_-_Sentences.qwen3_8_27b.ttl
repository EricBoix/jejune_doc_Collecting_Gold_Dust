    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 26 ;
    neo:sentence_number 5 ;
    neo:text "You may have lost your balance in that time but what you need to know is that mindfulness is present through it all."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3683 a neo:Document ;
