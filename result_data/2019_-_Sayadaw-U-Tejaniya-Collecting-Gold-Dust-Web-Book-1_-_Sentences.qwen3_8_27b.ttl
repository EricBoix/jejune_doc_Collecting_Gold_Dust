    neo:paragraph_number 3 ;
    neo:sentence_number 4 ;
    neo:text "I had to truly dedicate myself to them before I understood what \"Dhammam saranam gacchami: I go to the Dhamma for refuge\" truly meant and what a true refuge the Dhamma truly is."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3701 a neo:Document ;
