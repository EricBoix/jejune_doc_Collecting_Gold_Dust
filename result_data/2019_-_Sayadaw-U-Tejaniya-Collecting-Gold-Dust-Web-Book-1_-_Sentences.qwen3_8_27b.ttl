    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:sentence_number 5 ;
    neo:text "I prefer not to use terms like concentrate or penetrate into the object because I don't like the strong sense of effortful energy that is suggested by those words."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3474 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_1935,
