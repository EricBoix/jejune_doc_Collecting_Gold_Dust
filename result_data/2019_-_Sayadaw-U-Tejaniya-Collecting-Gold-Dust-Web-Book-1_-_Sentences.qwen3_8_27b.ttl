    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 4 ;
    neo:text "These are the five qualities that we are trying to cultivate in the mind."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3451 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_145,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_352 ;
