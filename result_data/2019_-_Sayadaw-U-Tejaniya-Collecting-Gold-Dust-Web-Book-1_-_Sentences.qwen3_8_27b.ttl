    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 9 ;
    neo:sentence_number 3 ;
    neo:text "So I never had greed when I meditated anymore."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_515 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_183,
