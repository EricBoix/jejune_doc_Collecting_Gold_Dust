        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_393 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:h3 "SPEAKING MINDFULLY"^^xsd:string ;
    neo:id "c0bea8969630112ae0efeb8ae18c3195"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 1 ;
    neo:text "We must be aware of ourselves every time we speak; come to know the many steps the mind goes through to speak."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2453 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_1435,
