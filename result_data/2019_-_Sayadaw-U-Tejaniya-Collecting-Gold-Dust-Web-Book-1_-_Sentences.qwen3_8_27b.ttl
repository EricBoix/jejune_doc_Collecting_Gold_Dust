    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2694,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2695,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_738 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:h3 "THINKING PROCESSES"^^xsd:string ;
    neo:id "8fcc3e898b47f06d17492bc60cb35805"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:sentence_number 4 ;
    neo:text "Naturally arising thoughts are not a problem because they are just objects to be known."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2696 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_1197 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:h3 "THINKING PROCESSES"^^xsd:string ;
