    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 9 ;
    neo:text "Once hooked on these ideas, the mind won't like it when one of these ideas is violated."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2828 a neo:Document ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
