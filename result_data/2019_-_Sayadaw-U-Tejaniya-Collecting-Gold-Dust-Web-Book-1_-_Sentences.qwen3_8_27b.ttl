    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:sentence_number 6 ;
    neo:text "Our work and our practice is always changing with this wisdom."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_441 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_96 ;
