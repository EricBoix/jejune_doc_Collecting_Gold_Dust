        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_858,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_859,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_860 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "1e34ddf26b9d39d4cece86b5045c9f63"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 25 ;
    neo:sentence_number 4 ;
    neo:text "The depression had already made me quite subdued at the marketplace I worked at, compared to the joker I had been previously, and then practicing continuously made me quieter."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_86 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_87,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_88,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_89 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Dear Reader"^^xsd:string ;
    neo:id "0d4a17a61951fe564ffe54706a6265fa"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:sentence_number 2 ;
    neo:text "When his long- time disciples make the migration to the Shwe Oo Min Dhamma Sukha Tawya Meditation Center in Yangon, Myanmar, one of his first questions is typically about their practice."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_861 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_43,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_854,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_862 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "b845848b96600cddf55aa587e6256432"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 26 ;
    neo:sentence_number 1 ;
    neo:text "However, taking on the four right speech precepts left me with hardly anything to say because I now avoided idle chatter."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_863 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_384,
