    neo:paragraph_number 2 ;
    neo:sentence_number 1 ;
    neo:text "Non-self' is just that principle of cause and effect."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2359 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2360,
