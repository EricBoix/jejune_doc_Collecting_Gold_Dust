    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 14 ;
    neo:sentence_number 17 ;
    neo:text "I only sought out meditation when it became my very last resort."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_618 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_419,
