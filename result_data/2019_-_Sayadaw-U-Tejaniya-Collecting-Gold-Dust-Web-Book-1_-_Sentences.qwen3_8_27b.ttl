    neo:paragraph_number 5 ;
    neo:sentence_number 8 ;
    neo:text "Right now, someone's actions are frustrating these beliefs and the mind justifies this anger against the other person!"^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2846 a neo:Document ;
