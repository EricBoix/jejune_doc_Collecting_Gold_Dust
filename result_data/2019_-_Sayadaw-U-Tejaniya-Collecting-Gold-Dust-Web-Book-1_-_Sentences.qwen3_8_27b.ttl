    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 2 ;
    neo:text "If there is always mindfulness, you will automatically follow the Five Precepts."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2306 a neo:Document ;
