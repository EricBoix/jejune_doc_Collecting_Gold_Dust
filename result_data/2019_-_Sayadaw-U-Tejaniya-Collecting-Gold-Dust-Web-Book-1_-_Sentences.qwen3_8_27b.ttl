        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_286,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_287 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "On Language"^^xsd:string ;
    neo:id "cb1fd82a44833e0f07f806fdb5ae577e"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 4 ;
    neo:text "The following words are used interchangeably: watching, being aware, observing, being mindful, recognizing, noticing, and paying attention."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2810 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2811,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2812,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2813,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_353,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_997 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:h3 "AWARENESS AT WORK"^^xsd:string ;
    neo:id "bc767e14caf2111ac99d4351b7e4e82f"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 1 ;
    neo:text "When you have a continuous practice that reminds and remembers and knows the mind at work, then it gets to the point where it becomes effortless because the mind becomes so familiar and so intimate with itself."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2814 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_328 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:h3 "AWARENESS AT WORK"^^xsd:string ;
    neo:id "a84d1446583b959579e30e41b5608ba6"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 2 ;
    neo:text "It is always with itself and it likes being with itself."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2815 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_20,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_328 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:h3 "AWARENESS AT WORK"^^xsd:string ;
    neo:id "fed07adc52f6494daa3212f9115fe0a6"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 3 ;
    neo:text "That's when it allows the mind to do anything because it doesn't mind; it's always with itself."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2816 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_1066,
