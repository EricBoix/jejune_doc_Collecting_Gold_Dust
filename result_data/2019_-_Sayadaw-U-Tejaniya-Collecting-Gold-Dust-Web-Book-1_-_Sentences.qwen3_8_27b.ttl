    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 19 ;
    neo:sentence_number 9 ;
    neo:text "This in hindsight was a blessing in disguise!"^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_755 a neo:Document ;
