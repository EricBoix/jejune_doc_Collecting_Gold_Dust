    neo:id "4c79f7263f8c1f95bb81071fc91212b6"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 7 ;
    neo:sentence_number 3 ;
    neo:text "We are more familiar with making an effort, like yogis making a physical effort not to be sleepy."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_449 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_153,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_421,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_450,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_96 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "e2bb9565a8fd75047e33b5e9e086c694"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 7 ;
    neo:sentence_number 4 ;
    neo:text "Instead, when we are sleepy we could actually check out the sleepiness, if we are curious, and wisdom would at once be at work: Why is there sleepiness now?"^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_451 a neo:Document ;
