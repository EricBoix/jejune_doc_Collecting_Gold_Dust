    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 10 ;
    neo:sentence_number 5 ;
    neo:text "As it was, my practice had built up quite a bit of momentum on the retreat so when the attention turned to what the mind was aware of, and what the mind knew, there was suddenly so much to know!"^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_530 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_328,
