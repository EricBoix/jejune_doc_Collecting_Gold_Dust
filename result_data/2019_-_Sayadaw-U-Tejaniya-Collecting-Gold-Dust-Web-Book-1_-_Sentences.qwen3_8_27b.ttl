    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 1 ;
    neo:text "Let's look more closely at the different pieces of meditation."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3446 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_1245,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_26,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3447 ;
