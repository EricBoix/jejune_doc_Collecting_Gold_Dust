    neo:paragraph_number 14 ;
    neo:sentence_number 6 ;
    neo:text "For someone with right view, samadhi, or stability of mind is automatically there."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3544 a neo:Document ;
