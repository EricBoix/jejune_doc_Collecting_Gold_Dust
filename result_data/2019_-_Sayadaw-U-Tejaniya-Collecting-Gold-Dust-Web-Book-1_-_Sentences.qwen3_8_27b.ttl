    neo:paragraph_number 8 ;
    neo:sentence_number 1 ;
    neo:text "I also had a first taste of the importance of the mind after an incident with a bed bug."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_468 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_349,
