    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 19 ;
    neo:sentence_number 5 ;
    neo:text "To begin with, why do you observe pain?"^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3595 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_15,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_328 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Appendix: Mindfulness in Brief"^^xsd:string ;
    neo:id "704a0cbf00118f4a9dad6f39264318ae"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 19 ;
    neo:sentence_number 6 ;
    neo:text "Do you want to make it go away?"^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3596 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_1203,
