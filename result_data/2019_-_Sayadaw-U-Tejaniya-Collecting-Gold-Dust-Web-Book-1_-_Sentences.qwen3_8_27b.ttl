    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 26 ;
    neo:sentence_number 4 ;
    neo:text "The purpose of mindfulness of speech is not to have a perfectly wise response, but to have a mindful conversation."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3682 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_388,
