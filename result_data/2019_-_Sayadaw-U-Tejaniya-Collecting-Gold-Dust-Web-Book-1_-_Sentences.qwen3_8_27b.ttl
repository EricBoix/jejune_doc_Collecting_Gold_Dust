    neo:paragraph_number 22 ;
    neo:sentence_number 2 ;
    neo:text "What can you understand about these experiences?"^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3640 a neo:Document ;
