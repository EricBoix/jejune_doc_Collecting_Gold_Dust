    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 28 ;
    neo:sentence_number 2 ;
    neo:text "It is so much more interesting at home when mindfulness is always present, and especially when we bring mindfulness to daily life situations."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3697 a neo:Document ;
