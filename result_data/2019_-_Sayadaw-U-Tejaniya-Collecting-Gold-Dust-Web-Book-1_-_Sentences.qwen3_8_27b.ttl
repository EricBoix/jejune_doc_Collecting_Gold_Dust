        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_573,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_720,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_727,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_728,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_729,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_730,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_731 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "cc72283685f7bd7b6c41e530b8464dac"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 18 ;
    neo:sentence_number 8 ;
    neo:text "Without attention on an object, the fear and anxiety could quickly become scary, and, if they became overwhelming, I used the inhaler because the sharp menthol smell and the sensation in my sinuses and forehead would bring my attention to these sensations and off the thoughts that fueled the emotions."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_732 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_384,
