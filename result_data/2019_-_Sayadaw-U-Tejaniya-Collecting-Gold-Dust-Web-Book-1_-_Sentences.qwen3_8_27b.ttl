    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 2 ;
    neo:text "Whether it is making an observation on his surroundings or commenting on the environment of the mind, Sayadaw, or \"the Teacher\" as his disciples fondly call him, delivers his teachings with a good dose of wit."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_601 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_43,
