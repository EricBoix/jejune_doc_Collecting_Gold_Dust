    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 9 ;
    neo:sentence_number 4 ;
    neo:text "Ironically that did not prevent me from having greed in many other aspects of my life, so much so that it led to depression."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_518 a neo:Document ;
