    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 7 ;
    neo:sentence_number 1 ;
    neo:text "Wisdom is one word but it encompasses so much and operates in many ways."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_442 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_344,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_443,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_444,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_96 ;
