    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 26 ;
    neo:sentence_number 1 ;
    neo:text "There are many things that can happen while you are talking."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3673 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_1194,
