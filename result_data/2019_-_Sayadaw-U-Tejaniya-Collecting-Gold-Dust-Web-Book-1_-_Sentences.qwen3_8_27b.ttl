    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 2 ;
    neo:text "Using his own experiences as guide and gradually honing his presentation, Sayadaw encourages meditators to always be persistent, experiment, and dig deeper into the Dhamma."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_660 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_43,
