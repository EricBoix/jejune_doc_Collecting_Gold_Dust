        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_651,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_652,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_653,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_654 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "231e54055ac2e1d2839e7c801c2e191a"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 16 ;
    neo:sentence_number 1 ;
    neo:text "The next day as I was taking a shower at a well, pulling up one pail of water after another and pouring it over myself in the heat, a man came running down a hillside."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_65 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_38,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_61 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Dear Reader"^^xsd:string ;
    neo:id "9b8d7addab9a0a042fb3a20d5a0ab027"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 1 ;
    neo:text "While the delivery may come with a bit of levity, Sayadaw is quite serious about the subject of Dhamma."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_655 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_654,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_73 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "156b87f469795389f1b9ca9d8b188185"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 16 ;
    neo:sentence_number 2 ;
    neo:text "He was large and very dark, his skin almost black, that he must have been in the heat a long time."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_656 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_43,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_649,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_652,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_653,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_73 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "745734fb2bfa17eee7b9aa5727fa24c9"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 16 ;
    neo:sentence_number 3 ;
    neo:text "He was sweating profusely and panting hard and he said to me as he ran towards me, \"Water, water\" and silently I handed him the pail full of water that I pulled up from the well."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_657 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_652,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_653,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_73 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "eef41cdf6142d60c1896a92e05a29f0c"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 16 ;
    neo:sentence_number 4 ;
    neo:text "He turned the pail up to drink directly from it and drank till all the water was gone!"^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_658 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_659,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_73 ;
