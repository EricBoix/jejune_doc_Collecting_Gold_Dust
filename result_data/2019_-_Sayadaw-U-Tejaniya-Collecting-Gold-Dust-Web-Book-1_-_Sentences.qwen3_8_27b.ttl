        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2461,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_388,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_44 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:h3 "SPEAKING MINDFULLY"^^xsd:string ;
    neo:id "1c9a70d7d41d3ccb6fff3d9c9ccb7f18"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 3 ;
    neo:text "But there is generally some inability or misunderstanding of how to remain aware when talking, and after a while I notice yogis speaking without being mindful and their momentum is gone."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2462 a neo:Document ;
