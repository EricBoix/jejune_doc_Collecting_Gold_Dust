    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 25 ;
    neo:sentence_number 7 ;
    neo:text "If you wanted to say something and you refrained from speaking then continue to know and recognize that you are not speaking but see the thinking going on in the mind."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3672 a neo:Document ;
