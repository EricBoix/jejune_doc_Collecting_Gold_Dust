    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 10 ;
    neo:sentence_number 8 ;
    neo:text "From then on, my practice changed."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_534 a neo:Document ;
