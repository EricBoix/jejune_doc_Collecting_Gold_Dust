    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:sentence_number 6 ;
    neo:text "The mind has convinced itself of all these strands of thought!"^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2842 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_153,
