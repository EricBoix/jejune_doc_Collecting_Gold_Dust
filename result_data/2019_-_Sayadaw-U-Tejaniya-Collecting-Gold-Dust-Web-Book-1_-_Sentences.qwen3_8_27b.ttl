    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:sentence_number 7 ;
    neo:text "At times like these, we should ask ourselves, \"What internal belief is being thwarted here?\""^^xsd:string .

