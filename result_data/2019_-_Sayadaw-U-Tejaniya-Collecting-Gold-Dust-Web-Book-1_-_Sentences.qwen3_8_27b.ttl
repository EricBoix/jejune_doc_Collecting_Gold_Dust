    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 25 ;
    neo:sentence_number 4 ;
    neo:text "You do not want to cut off speech without awareness of what you need to do."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3666 a neo:Document ;
