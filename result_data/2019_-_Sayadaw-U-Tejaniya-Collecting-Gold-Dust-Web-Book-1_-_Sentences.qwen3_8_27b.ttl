        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_454,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_455 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
