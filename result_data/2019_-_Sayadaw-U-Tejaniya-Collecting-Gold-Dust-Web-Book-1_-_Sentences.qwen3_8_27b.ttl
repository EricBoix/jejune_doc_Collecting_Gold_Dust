    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 15 ;
    neo:sentence_number 12 ;
    neo:text "That was the first thing that made me afraid to die, not in general, but right then in that state."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_648 a neo:Document ;
