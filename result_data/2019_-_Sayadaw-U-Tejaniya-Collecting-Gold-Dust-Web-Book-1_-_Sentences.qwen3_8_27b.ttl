    neo:paragraph_number 3 ;
    neo:sentence_number 2 ;
    neo:text "It is nothing extraordinary."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2469 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_18,
