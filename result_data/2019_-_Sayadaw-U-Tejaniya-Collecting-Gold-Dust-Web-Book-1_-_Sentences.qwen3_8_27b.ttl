    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 22 ;
    neo:sentence_number 3 ;
    neo:text "And one day I had a moment of clarity."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_798 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_353,
