        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_848 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "ec1cc964ce63e739d975a82158bf1fcd"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 25 ;
    neo:sentence_number 1 ;
    neo:text "A year in, I read an article about the ajivatthamaka sila, eight precepts with right livelihood as the eighth precept."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_849 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_322,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_850,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_851,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_852,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_853,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_854 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "b981ffc88434d6dee170196003bceadf"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 25 ;
    neo:sentence_number 2 ;
    neo:text "I was particularly interested in the expansion of the precept on not telling untruths, into four precepts for right speech: refraining from telling lies, slander, harsh speech, and idle chatter."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_855 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_43,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_477 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "f6b4a1d9cfcac4bea571ab5d1760b2b9"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 25 ;
    neo:sentence_number 3 ;
    neo:text "I was inspired to try this."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_856 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_159,
