        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_68,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_69,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_70,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_71 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Dear Reader"^^xsd:string ;
