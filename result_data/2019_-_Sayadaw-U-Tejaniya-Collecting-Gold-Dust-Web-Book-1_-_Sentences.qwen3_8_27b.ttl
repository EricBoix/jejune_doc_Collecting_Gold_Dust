    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:sentence_number 1 ;
    neo:text "Many types of insights can be awakened."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_428 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_429,
