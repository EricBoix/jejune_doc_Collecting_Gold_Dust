    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 1 ;
    neo:text "I was about 13 years old when I started to meditate."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_375 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_376,
