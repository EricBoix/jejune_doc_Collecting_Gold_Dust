    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:sentence_number 3 ;
    neo:text "We also need to know how to regard objects, to have the right view toward the objects, and be able to consider them in the right way."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3458 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_143,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_344,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3459 ;
