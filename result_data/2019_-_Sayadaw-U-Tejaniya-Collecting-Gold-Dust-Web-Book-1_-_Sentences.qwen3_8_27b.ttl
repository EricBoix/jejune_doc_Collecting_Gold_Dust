    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:h3 "THINKING PROCESSES"^^xsd:string ;
    neo:id "a597cb77d1db12e7bf72cd93f696639c"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:sentence_number 1 ;
    neo:text "When there are strong wholesome qualities in the mind, it is difficult for the mind to suddenly change and become unwholesome; when there is a strong unwholesome train of thought going on, it's difficult for it to suddenly switch and become wholesome."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2705 a neo:Document ;
