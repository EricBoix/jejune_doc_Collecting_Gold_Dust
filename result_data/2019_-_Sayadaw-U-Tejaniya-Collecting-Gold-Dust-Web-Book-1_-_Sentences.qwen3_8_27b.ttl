    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "ff429012b594c36c38b6e904eabcd393"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 14 ;
    neo:sentence_number 8 ;
    neo:text "In hindsight, I think the feelings that came up had something to do with some insights into dukkha not being fully understood or realized."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_60 a neo:Document ;
