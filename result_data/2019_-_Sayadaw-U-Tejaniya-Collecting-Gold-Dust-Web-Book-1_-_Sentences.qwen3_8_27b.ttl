    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 7 ;
    neo:sentence_number 1 ;
    neo:text "The mind seeks variety, novelty and freshness and becomes lazy or bored when it's not satiated."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2294 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2295,
