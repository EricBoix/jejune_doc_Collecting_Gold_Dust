    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 19 ;
    neo:sentence_number 8 ;
    neo:text "It was demotivating yet I had to keep at it; otherwise, the mental suffering came back."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_753 a neo:Document ;
