    neo:paragraph_number 28 ;
    neo:sentence_number 3 ;
    neo:text "In your talking to others you learn to see others' intentions and learn to speak in a way that helps you to manage yourself and manage the conversation as well."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_370 a neo:Document ;
