    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:h3 "THINKING PROCESSES"^^xsd:string ;
    neo:id "08e579684825f13b472186d013465d36"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 1 ;
    neo:text "It is best not to observe the thinking mind alone."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2699 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_599,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_956 ;
