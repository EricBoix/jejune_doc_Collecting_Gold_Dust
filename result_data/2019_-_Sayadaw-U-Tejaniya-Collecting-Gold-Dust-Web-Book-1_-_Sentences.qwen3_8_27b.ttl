    neo:id "d706fb88dc9a25ec8aee0e4cfcd59a94"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 19 ;
    neo:sentence_number 1 ;
    neo:text "The suffering feeling reminded me to be mindful and that mindfulness made me feel a bit better each time I was mindful."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_735 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_43,
