    neo:paragraph_number 2 ;
    neo:sentence_number 2 ;
    neo:text "The combination word \"awareness + wisdom,\" first coined by Sayadaw, but used freely before the book Dhamma Everywhere came out, underscores the need for more than mere awareness in vipassana (insight) meditation."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2970 a neo:Document ;
