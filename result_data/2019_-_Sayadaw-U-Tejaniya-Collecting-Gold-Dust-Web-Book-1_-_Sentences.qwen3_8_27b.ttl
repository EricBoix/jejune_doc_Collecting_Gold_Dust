    neo:id "faea7822a77fbe94daddb102fb5da5a7"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 10 ;
    neo:sentence_number 3 ;
    neo:text "When thoughts were noticed, I acknowledged them then returned to the task of being aware of all my bodily movements and sensations, over and over again all day long."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_524 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_274,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_353,
