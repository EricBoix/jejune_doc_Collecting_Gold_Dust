    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 26 ;
    neo:sentence_number 3 ;
    neo:text "While the mind may still be agitated, at the very least, you can still be aware."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3678 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3679,
