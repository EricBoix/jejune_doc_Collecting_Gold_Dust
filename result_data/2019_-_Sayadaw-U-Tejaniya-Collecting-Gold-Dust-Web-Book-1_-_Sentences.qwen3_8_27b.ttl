    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 10 ;
    neo:sentence_number 9 ;
    neo:text "Whenever I went on retreat, I would, in sitting and in all activities, lead with the question: What is the mind knowing?"^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_538 a neo:Document ;
