        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_43,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_540 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:h3 "SPEAKING MINDFULLY"^^xsd:string ;
    neo:id "edfeda4d24cc28b022a719145cad889d"^^xsd:string ;
