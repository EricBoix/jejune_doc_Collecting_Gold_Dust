        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_96 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:h3 "SPEAKING MINDFULLY"^^xsd:string ;
    neo:id "b1b1bd2e81931b164fe9a0427ac63bf4"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:sentence_number 3 ;
    neo:text "The Satipatthana Sutta prescribes, \"When silent, be silent with awareness and wisdom, when speaking, speak with awareness and wisdom,\" but few people practice that."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_247 a neo:Document ;
