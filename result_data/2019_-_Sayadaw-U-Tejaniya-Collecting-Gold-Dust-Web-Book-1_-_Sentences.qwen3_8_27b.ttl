    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:sentence_number 5 ;
    neo:text "This is the growth of wisdom."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_440 a neo:Document ;
