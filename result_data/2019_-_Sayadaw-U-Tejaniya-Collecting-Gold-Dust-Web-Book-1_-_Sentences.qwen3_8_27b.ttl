    neo:paragraph_number 3 ;
    neo:sentence_number 7 ;
    neo:text "Every day we are losing time, losing the object, losing awareness, in every moment."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2451 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2433,
