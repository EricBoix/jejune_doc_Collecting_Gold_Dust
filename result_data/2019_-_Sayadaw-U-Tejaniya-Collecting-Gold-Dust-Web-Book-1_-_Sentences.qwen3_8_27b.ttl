    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:sentence_number 4 ;
    neo:text "Or different thoughts of fairness might come up."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2839 a neo:Document ;
