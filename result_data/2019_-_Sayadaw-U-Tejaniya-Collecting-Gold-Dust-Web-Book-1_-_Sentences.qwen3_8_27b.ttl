    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 15 ;
    neo:sentence_number 10 ;
    neo:text "I saw it was all negative thinking in the mind."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_641 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_353,
