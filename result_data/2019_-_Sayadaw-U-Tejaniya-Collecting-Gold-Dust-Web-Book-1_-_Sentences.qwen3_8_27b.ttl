    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 9 ;
    neo:sentence_number 1 ;
    neo:text "I didn't know the mind directly then, but I just realized very deeply that greed was neither useful nor helpful when practicing meditation."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_512 a neo:Document ;
