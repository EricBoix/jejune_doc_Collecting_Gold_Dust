    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 14 ;
    neo:sentence_number 15 ;
    neo:text "I did try to take short holidays to places I had gone to with my friends before but nothing helped."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_616 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_391,
