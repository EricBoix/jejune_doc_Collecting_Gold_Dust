    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 18 ;
    neo:sentence_number 7 ;
    neo:text "I did not begin using other objects until months afterwards."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_726 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_295,
