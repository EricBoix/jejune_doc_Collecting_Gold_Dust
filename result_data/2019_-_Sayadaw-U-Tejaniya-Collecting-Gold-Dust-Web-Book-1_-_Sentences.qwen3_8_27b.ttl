    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 26 ;
    neo:sentence_number 2 ;
    neo:text "If you are triggered when you are talking to someone, the fact that you are triggered but are still there, with the person, might trigger other emotions like embarrassment or agitation."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3677 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_1205,
