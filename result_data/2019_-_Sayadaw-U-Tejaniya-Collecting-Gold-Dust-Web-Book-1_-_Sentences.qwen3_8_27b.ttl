        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_578,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_579,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_580 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "dd0c59bfa8697fddb5287cc71af8eff9"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 12 ;
    neo:sentence_number 5 ;
    neo:text "It was the love, or actually greed for fun that indirectly led to my years of depression."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_581 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_43,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_516,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_582 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "3bfeb4d52d43f0a155c0781659ecfbea"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 13 ;
    neo:sentence_number 1 ;
    neo:text "Initially I forgot about my unhappiness after a while, because it wasn't very strong then and the depression seemed to go away."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_583 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_43,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_584 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "96aedf9d70f762a653749c7bd8979af7"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 13 ;
    neo:sentence_number 2 ;
    neo:text "When it returned a second time, I got fed up of feeling mopey and angrily railed against the emotion and willed myself to overcome it that way."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_585 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_43,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_551,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_586,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_587,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_83,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_99 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "31b82c722dd5f5587a5094179bbe3269"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 14 ;
    neo:sentence_number 1 ;
    neo:text "While I was working with my father, I got more of an opportunity to go for longer retreats at my teacher's monastery too, than when I had been in school."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_588 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_43,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_563,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_589 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "2c4db8d4004e6b4d177d3743ef74166f"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 14 ;
    neo:sentence_number 2 ;
    neo:text "My father had no objections to my going and I mostly did the customary days off during the Burmese New Year."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_590 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_419,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_43,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_560,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_591 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "93954f00d99058d152cf79933d5abad5"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 14 ;
    neo:sentence_number 3 ;
    neo:text "At one point I thought I wanted to be a monk for life and told my family and my teacher and they were all happy for me."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_592 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_138,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_43 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "0756bc6aedd4602d0f810e2202101e73"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 14 ;
    neo:sentence_number 4 ;
    neo:text "Ten months in, my mind had changed again, and I just could not stay at the center any longer."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_593 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_353,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_384,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_419,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_594 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "b2ff29f60345d5952f54e0437dc2abc3"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 14 ;
    neo:sentence_number 5 ;
    neo:text "My teacher gently tried to persuade me to stay but when my mind was made up there was no changing it."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_595 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_43,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_84 ;
