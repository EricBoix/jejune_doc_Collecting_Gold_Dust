    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 2 ;
    neo:text "There are five qualities in our minds that do the work of meditation."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3448 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_120,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_1308,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_18,
