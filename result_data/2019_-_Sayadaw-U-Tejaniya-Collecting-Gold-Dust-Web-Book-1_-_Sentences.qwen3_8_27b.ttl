    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 5 ;
    neo:text "There are also six sense objects arising at the six sense doors."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3452 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_145,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3453,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_352,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_353 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Appendix: Mindfulness in Brief"^^xsd:string ;
    neo:id "19fbbcd213549efdfbd3a23be8bd0f80"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 6 ;
    neo:text "These six sense objects are our stepping-stones in that we use the objects that arise at the six sense doors to cultivate the five good qualities of the mind."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3454 a neo:Document ;
