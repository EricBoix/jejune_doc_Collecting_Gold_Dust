    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 2 ;
    neo:text "When we talk about the process of conditioning, remember there's a stream of minds in the conditioned process."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3222 a neo:Document ;
