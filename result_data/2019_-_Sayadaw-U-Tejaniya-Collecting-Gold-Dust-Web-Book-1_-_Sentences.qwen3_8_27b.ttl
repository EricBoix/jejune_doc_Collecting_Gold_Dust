    neo:id "4ccd4adf540eb7fc5f39daa2a106f705"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 6 ;
    neo:text "I knew that people would run into me if I didn't move aside, but also became annoyed that I was the one who always had to be careful."^^xsd:string .

