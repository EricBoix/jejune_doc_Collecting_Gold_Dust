    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 15 ;
    neo:sentence_number 11 ;
    neo:text "I realized if I died with the mind in this state, it was not going to a good state/place."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_644 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_384,
