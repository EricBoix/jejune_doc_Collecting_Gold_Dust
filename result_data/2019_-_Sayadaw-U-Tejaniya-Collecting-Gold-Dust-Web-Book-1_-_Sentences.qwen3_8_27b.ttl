    neo:paragraph_number 9 ;
    neo:sentence_number 2 ;
    neo:text "It had no place in getting me results."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_514 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_183,
