    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:sentence_number 2 ;
    neo:text "We also need to be consciously aware of what we know."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3457 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_119,
