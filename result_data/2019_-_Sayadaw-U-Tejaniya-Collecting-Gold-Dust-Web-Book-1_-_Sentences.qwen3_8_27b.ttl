    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 7 ;
    neo:text "This was a daily occurrence."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2943 a neo:Document ;
