    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:h3 "THINKING PROCESSES"^^xsd:string ;
    neo:id "831408e02cf5e6c235765e22e7e6f6bc"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 2 ;
    neo:text "Also watch the feelings that accompany this thinking so that you can know when it is becoming too much."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2700 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_15,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2701 ;
