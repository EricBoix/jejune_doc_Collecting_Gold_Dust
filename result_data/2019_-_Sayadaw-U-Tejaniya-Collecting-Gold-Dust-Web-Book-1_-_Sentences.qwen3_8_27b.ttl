    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:sentence_number 8 ;
    neo:text "What does it feel like?"^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_453 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_153,
