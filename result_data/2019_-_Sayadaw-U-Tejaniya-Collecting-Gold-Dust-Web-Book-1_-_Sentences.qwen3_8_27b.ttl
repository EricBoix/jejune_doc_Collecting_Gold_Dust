    neo:paragraph_number 5 ;
    neo:sentence_number 3 ;
    neo:text "I tried to intentionally think negative thoughts and realized that I could not."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2708 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2688,
