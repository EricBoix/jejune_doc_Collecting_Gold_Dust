    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 4 ;
    neo:text "I now limit the practice to just one session to give just a taste of what it might be like to speak mindfully."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2465 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2466,
