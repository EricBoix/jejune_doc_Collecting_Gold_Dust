    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:sentence_number 4 ;
    neo:text "They prevent us from seeing clearly; we cannot see objects for what they truly are."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3445 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_26 ;
