    neo:paragraph_number 25 ;
    neo:sentence_number 3 ;
    neo:text "Speaking is all around us in daily life."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_3665 a neo:Document ;
