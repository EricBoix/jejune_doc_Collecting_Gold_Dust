        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_97 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:h3 "SPEAKING MINDFULLY"^^xsd:string ;
    neo:id "328ac92b80196fee860194a76d5bc7d0"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 1 ;
    neo:text "For some time I have had yogis not speak for two-thirds of a retreat and then, in the remaining one-third I explain how to be mindful while speaking and get the yogis to try mindful speech for a few days."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2458 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_124,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2455,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_398,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_44 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:h3 "SPEAKING MINDFULLY"^^xsd:string ;
    neo:id "0d412658a326cff793efa427d8520c41"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 2 ;
    neo:text "Ideally yogis will have built up enough momentum and continue being mindful while speaking."^^xsd:string .

ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_2459 a neo:Document ;
    neo:MENTIONS ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_1089,
        ex:node_4_48486d37_a87c_48ab_920e_41abda1674af_124,
