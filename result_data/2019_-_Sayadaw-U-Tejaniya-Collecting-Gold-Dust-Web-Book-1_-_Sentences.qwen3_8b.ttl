    neo:paragraph_number 24 ;
    neo:sentence_number 5 ;
    neo:text "You don't want to be growing aversion any more than you want to be growing greed."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3497 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_145,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3498,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_448 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Appendix: Mindfulness in Brief"^^xsd:string ;
    neo:id "245249209a250f48644d6510d4f3402f"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 24 ;
    neo:sentence_number 6 ;
    neo:text "Understanding that the pain might become too much, you let go of the pain and make yourself more comfortable to prevent the growth of aversion."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3499 a neo:Document ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Appendix: Mindfulness in Brief"^^xsd:string ;
    neo:id "e3d17b401966aba7d84611de2eb29dce"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 25 ;
    neo:sentence_number 1 ;
    neo:text "Finally, let's discuss talking."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3500 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_131,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2549,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_276,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3501 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Appendix: Mindfulness in Brief"^^xsd:string ;
    neo:id "80d04a000d847f99eb013148cbbca283"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 25 ;
    neo:sentence_number 2 ;
    neo:text "We should try to practice right speech and only say what is necessary and wholesome and for this we do need mindfulness."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3502 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_148,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2275 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Appendix: Mindfulness in Brief"^^xsd:string ;
    neo:id "019529e51ee7c347055072735f570702"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 25 ;
    neo:sentence_number 3 ;
    neo:text "Speaking is all around us in daily life."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3503 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_15 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Appendix: Mindfulness in Brief"^^xsd:string ;
    neo:id "943045f7d9d442f25572e378534df4f6"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 25 ;
    neo:sentence_number 4 ;
    neo:text "You do not want to cut off speech without awareness of what you need to do."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3505 a neo:Document ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Appendix: Mindfulness in Brief"^^xsd:string ;
    neo:id "7f037c2b4da3375a95335ab0c8af7a03"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 25 ;
    neo:sentence_number 5 ;
    neo:text "Use some restraint and know, consider and understand before you speak."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3506 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_15,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3507 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Appendix: Mindfulness in Brief"^^xsd:string ;
    neo:id "b7adea938b5d32b7bd7eee60a90f1558"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 25 ;
    neo:sentence_number 6 ;
    neo:text "Then you will also know if there is a need to talk."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3508 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_1266,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_15 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Appendix: Mindfulness in Brief"^^xsd:string ;
    neo:id "849422aaea9600bccfc1cda2a8424080"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 25 ;
    neo:sentence_number 7 ;
    neo:text "If you wanted to say something and you refrained from speaking then continue to know and recognize that you are not speaking but see the thinking going on in the mind."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3509 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_1017 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Appendix: Mindfulness in Brief"^^xsd:string ;
    neo:id "f982c2d7b08f99d1f057e9a9e43ac69e"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 26 ;
    neo:sentence_number 1 ;
    neo:text "There are many things that can happen while you are talking."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_351 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_335,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_338 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "e07f1cc8eef1e48a575294d54c48e20f"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:sentence_number 1 ;
    neo:text "Sayadawgyi often asked me why certain things happened when I went to him to describe my experiences."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3510 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_1116,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3511,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3512 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Appendix: Mindfulness in Brief"^^xsd:string ;
    neo:id "a9e87cc0728a468abab26d665f7ce6e4"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 26 ;
    neo:sentence_number 2 ;
    neo:text "If you are triggered when you are talking to someone, the fact that you are triggered but are still there, with the person, might trigger other emotions like embarrassment or agitation."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3513 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_1133,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_1269,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_15,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_311 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Appendix: Mindfulness in Brief"^^xsd:string ;
    neo:id "33709bf5fc42f3f4baaf44f5c3a05271"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 26 ;
    neo:sentence_number 3 ;
    neo:text "While the mind may still be agitated, at the very least, you can still be aware."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3514 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3515,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3516 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Appendix: Mindfulness in Brief"^^xsd:string ;
    neo:id "abb2abbcb4f84c47a5c4c6dd958df749"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 26 ;
    neo:sentence_number 4 ;
    neo:text "The purpose of mindfulness of speech is not to have a perfectly wise response, but to have a mindful conversation."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3517 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_131,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_1872 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Appendix: Mindfulness in Brief"^^xsd:string ;
    neo:id "8317f6993e71639a214354878f30e194"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 26 ;
    neo:sentence_number 5 ;
    neo:text "You may have lost your balance in that time but what you need to know is that mindfulness is present through it all."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3518 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_1263,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3519 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Appendix: Mindfulness in Brief"^^xsd:string ;
    neo:id "2843b00c5acc5403628b1a851e53ec55"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 27 ;
    neo:sentence_number 1 ;
    neo:text "If you are strongly attached to ideas, there will be triggers when someone else presents a conflicting idea."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_352 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_337,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_353,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_354,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_39 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "e697ab740ccde80ffbf36382cb733115"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:sentence_number 2 ;
    neo:text "One episode in particular was when he asked me to find out why the abdomen rises and falls (that was my main object at that time) and I said it was because of the breath."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3520 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3521,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3522 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Appendix: Mindfulness in Brief"^^xsd:string ;
    neo:id "a2df216a5c3ce99683addf4e20fb310e"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 26 ;
    neo:sentence_number 7 ;
    neo:text "It's like North and South Korea being at war, separated by ideology."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3523 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_131,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_1727,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3013 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Appendix: Mindfulness in Brief"^^xsd:string ;
    neo:id "53ffd4c6bcb26863a38ef8b968a6b17a"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 26 ;
    neo:sentence_number 8 ;
    neo:text "You can learn some lessons from these conversations when there is mindfulness."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3524 a neo:Document ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Appendix: Mindfulness in Brief"^^xsd:string ;
    neo:id "7e545cbd24ff5cb5760e6eea1512e3f7"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 26 ;
    neo:sentence_number 9 ;
    neo:text "Whenever we say something wrong, we will suffer a little bit but if mindfulness stays with us, we will always learn."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3525 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_495 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Appendix: Mindfulness in Brief"^^xsd:string ;
    neo:id "c71fdbe60427fa7f87d0d211a38c4cd1"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 28 ;
    neo:sentence_number 1 ;
    neo:text "Be a little extra careful at home."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3526 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_131,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3527,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_495 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Appendix: Mindfulness in Brief"^^xsd:string ;
    neo:id "75132737fcf797dd11a4a200129826a7"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 28 ;
    neo:sentence_number 2 ;
    neo:text "It is so much more interesting at home when mindfulness is always present, and especially when we bring mindfulness to daily life situations."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3528 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3529,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3530 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Appendix: Mindfulness in Brief"^^xsd:string ;
    neo:id "23f1e2065c8be4d1a83386144ba596a2"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 28 ;
    neo:sentence_number 3 ;
    neo:text "In your talking to others you learn to see others' intentions and learn to speak in a way that helps you to manage yourself and manage the conversation as well."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3531 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_120,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3532,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3533 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Appendix: Mindfulness in Brief"^^xsd:string ;
    neo:id "bcce576398d32fcf9eb04b9e63ac1d93"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 28 ;
    neo:sentence_number 4 ;
    neo:text "We begin to know what we are going to say before we say it and eventually have time to choose the skillful path."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3534 a neo:Document ;
