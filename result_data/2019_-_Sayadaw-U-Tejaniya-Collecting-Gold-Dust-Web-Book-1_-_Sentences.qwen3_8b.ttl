    neo:paragraph_number 11 ;
    neo:sentence_number 5 ;
    neo:text "I wanted to know how much this affected my mind and I became really interested."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2428 a neo:Document ;
