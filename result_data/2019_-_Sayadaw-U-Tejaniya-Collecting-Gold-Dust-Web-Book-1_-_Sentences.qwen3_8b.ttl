    neo:paragraph_number 1 ;
    neo:sentence_number 8 ;
    neo:text "Meditation is this latter part, the work of the mind, and the work to transform the mind."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3257 a neo:Document ;
