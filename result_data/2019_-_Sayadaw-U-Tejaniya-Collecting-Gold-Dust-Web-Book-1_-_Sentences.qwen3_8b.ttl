    neo:id "cbb541d8f6e1a66609ed9df9496f3d8d"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 1 ;
    neo:text "For most of us, awareness + wisdom are not ready and on standby so defilements are allowed to arise over and over."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_1154 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_1155,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_47,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_691 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Mindfulness is a Lifestyle Change"^^xsd:string ;
    neo:h3 "HOW DO WE MAKE INROADS?"^^xsd:string ;
    neo:id "c805dc0921c0c87a452abdcdf83a0d8a"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 2 ;
    neo:text "It's a vicious cycle: we can't get peace; then we can't make inroads into the practice; so we can't get peace."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_1156 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_18,
