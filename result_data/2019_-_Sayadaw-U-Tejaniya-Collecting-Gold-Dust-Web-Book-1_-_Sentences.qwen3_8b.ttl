    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 7 ;
    neo:text "I was so focused on the mindfulness that anything I noticed about myself became a source of joy: it meant I was mindful!"^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3460 a neo:Document ;
