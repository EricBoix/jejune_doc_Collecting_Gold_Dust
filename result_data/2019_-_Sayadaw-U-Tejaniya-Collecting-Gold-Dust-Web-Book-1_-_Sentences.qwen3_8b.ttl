    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:h3 "SEEING IS DIFFERENT FROM LOOKING"^^xsd:string ;
    neo:id "812b0f2eae25f37b169559cf974e2ec1"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 2 ;
    neo:text "I learned how to be aware with my eyes open because fellow shopkeepers used to tease me when I meditated at work with my eyes closed."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2451 a neo:Document ;
