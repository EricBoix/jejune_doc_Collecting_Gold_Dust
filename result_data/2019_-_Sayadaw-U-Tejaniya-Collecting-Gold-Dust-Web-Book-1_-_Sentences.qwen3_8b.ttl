        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3132,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_47 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Continuing the Work"^^xsd:string ;
    neo:h3 "EFFORTLESS AWARENESS"^^xsd:string ;
    neo:id "e99bd28fdbf66c7a083e1e3fd3043152"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 2 ;
    neo:text "If you are personally very involved in trying to do the practice, you will not be able to see what is going on naturally."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3133 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3134,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3135 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Continuing the Work"^^xsd:string ;
    neo:h3 "EFFORTLESS AWARENESS"^^xsd:string ;
    neo:id "029353f840d71f7f0a39e76d3551e16e"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 1 ;
    neo:text "We always need to remember the difference between personal exertion and the energy of the dhamma taking over."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3136 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3137,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_320 ;
