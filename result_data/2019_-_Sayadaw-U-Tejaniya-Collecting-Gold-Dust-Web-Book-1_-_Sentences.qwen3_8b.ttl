ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2567 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2568,
