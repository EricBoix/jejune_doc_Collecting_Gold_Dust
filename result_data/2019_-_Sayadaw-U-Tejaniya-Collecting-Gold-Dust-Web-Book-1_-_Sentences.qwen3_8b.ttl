    neo:paragraph_number 28 ;
    neo:sentence_number 3 ;
    neo:text "I want to persuade you that this is possible."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_828 a neo:Document ;
