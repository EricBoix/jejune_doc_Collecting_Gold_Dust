    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 17 ;
    neo:sentence_number 6 ;
    neo:text "Thinking is the mind and the definition of mind is that which thinks and that which knows."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3403 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3404,
