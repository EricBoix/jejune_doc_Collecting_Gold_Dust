    neo:paragraph_number 7 ;
    neo:sentence_number 3 ;
    neo:text "We are more familiar with making an effort, like yogis making a physical effort not to be sleepy."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_399 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_301,
