    neo:h2 "Continuing the Work"^^xsd:string ;
    neo:h3 "EFFORTLESS AWARENESS"^^xsd:string ;
    neo:id "02557899341c74be43844b2fe9c4dd03"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 1 ;
    neo:text "I would like yogis, especially for those who have been practicing for years, to get to the point where they realize that without focusing or paying attention, that knowing is happening."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3144 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_320,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_47 ;
