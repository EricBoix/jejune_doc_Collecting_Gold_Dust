    neo:paragraph_number 12 ;
    neo:sentence_number 1 ;
    neo:text "It's good to know, as information, that, it is possible to be mindful when you speak."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2435 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2436,
