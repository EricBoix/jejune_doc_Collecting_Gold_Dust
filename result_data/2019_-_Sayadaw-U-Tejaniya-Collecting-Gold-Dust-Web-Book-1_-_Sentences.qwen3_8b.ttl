    neo:paragraph_number 30 ;
    neo:sentence_number 2 ;
    neo:text "If we don't change and grow, it is akin to being dead."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_856 a neo:Document ;
