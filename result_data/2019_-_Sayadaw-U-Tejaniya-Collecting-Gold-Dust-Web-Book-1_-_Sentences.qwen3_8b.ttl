    neo:id "Med, "^^xsd:string ;
    neo:llm_model_name "qwen3:8b"^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3344 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_15,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_18 ;
