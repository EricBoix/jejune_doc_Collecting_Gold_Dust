    neo:sentence_number 3 ;
    neo:text "Unfortunately, personal effort is short-lived and does not allow us to function in the day-to-day."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2896 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_120,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2897 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Lighter Approach"^^xsd:string ;
    neo:id "8eba51ebcd4015452dd2edb53f9fbde5"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 4 ;
    neo:text "We then begin to doubt our ability to live our lives with awareness."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2898 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_18,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2899,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2900 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Lighter Approach"^^xsd:string ;
