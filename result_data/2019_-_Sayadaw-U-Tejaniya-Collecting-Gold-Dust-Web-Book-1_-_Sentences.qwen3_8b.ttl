    neo:paragraph_number 9 ;
    neo:sentence_number 1 ;
    neo:text "May All Beings Be Happy!"^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3244 a neo:Document ;
