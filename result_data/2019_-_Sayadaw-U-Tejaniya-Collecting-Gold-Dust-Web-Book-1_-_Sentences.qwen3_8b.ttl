    neo:h2 "Continuing the Work"^^xsd:string ;
    neo:h3 "EFFORTLESS AWARENESS"^^xsd:string ;
    neo:id "1194c4c4a9ab414f20f7cfd849122ef6"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:sentence_number 3 ;
    neo:text "This way you will slowly understand what is actually happening and this will enable you to let go of the old paradigm."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3153 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3154,
