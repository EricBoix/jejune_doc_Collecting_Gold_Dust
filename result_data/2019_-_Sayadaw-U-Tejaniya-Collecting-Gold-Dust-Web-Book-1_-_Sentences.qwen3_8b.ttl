    neo:h2 "Reflect. Learn. Keep Going."^^xsd:string ;
    neo:h3 "HOW TO WORK WITH DIFFICULTIES"^^xsd:string ;
    neo:id "4351ff6f768060a4ad53229c4a7aaba3"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 7 ;
    neo:text "It finally occurred to me one day that even if I were to go to the moon, the depression would also follow me there."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_1955 a neo:Document ;
