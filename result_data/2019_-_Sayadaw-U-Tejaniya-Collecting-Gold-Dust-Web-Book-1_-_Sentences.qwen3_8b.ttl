    neo:paragraph_number 1 ;
    neo:sentence_number 1 ;
    neo:text "My special gratitude goes to my teacher, the late Venerable Shwe Oo Min Sayadaw Bhaddanta Kosalla Mahathera, who taught me the Dhamma and right attitude for my spiritual development and meditation practice."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_340 a neo:Document ;
