    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 20 ;
    neo:sentence_number 1 ;
    neo:text "I worked at my father's shop, trying to cope with the demands of the business in my state of anxiety, uncertainty, and fear."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_708 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_39,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_709 ;
