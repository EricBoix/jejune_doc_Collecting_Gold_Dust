    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 7 ;
    neo:sentence_number 8 ;
    neo:text "The more we practice, the more the mind understands how to practice and it doesn't have to think about how to practice."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3240 a neo:Document ;
