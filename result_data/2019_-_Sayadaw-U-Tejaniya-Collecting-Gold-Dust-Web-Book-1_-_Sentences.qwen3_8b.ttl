    neo:h2 "A Lighter Approach"^^xsd:string ;
    neo:id "3be32ca5c399df42bbb56d922065b58d"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:sentence_number 6 ;
    neo:text "When the power is right for you, then you see the letters clearly."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2912 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_1905,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2907,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2913 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Lighter Approach"^^xsd:string ;
