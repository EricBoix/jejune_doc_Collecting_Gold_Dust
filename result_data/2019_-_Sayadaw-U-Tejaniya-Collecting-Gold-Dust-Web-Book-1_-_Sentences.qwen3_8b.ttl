    neo:h2 "A Lighter Approach"^^xsd:string ;
    neo:id "ab19c7669ae806e1e65212bf9d5d9519"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:sentence_number 9 ;
    neo:text "While you may assume that putting in more personal effort will yield better results, you may still not be able to see clearly."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2918 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2919,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2920 ;
