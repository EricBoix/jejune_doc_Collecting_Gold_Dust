    neo:paragraph_number 1 ;
    neo:sentence_number 4 ;
    neo:text "So I learned to pay attention to the internal landscape while keeping my eyes open."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2455 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_1054,
