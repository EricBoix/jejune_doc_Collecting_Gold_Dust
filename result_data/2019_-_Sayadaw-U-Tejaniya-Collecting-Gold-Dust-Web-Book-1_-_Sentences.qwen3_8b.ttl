    neo:h3 "CAUSES AND CONDITIONS"^^xsd:string ;
    neo:id "efe13b3adc9f670ec0112e02fb173f17"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:sentence_number 4 ;
    neo:text "If we are just happy in la la land we don't get to learn what it is like to be unmindful."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2246 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_1708,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_40 ;
