    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 15 ;
    neo:sentence_number 5 ;
    neo:text "You can know that sound is just sound but wisdom must also understand what that sound means."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3386 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3387,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3388 ;
