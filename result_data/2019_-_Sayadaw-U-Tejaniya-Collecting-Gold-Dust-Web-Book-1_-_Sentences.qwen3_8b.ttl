    neo:paragraph_number 4 ;
    neo:sentence_number 8 ;
    neo:text "It never mattered to me even if I discovered an undesirable quality because the point I saw was that I was mindful."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3490 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3491,
