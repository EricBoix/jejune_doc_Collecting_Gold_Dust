    neo:h2 "Continuing the Work"^^xsd:string ;
    neo:h3 "EFFORTLESS AWARENESS"^^xsd:string ;
    neo:id "a20248d2590c907a9eeeee0a33044230"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 2 ;
    neo:text "After many years of meditating, their practice must have gained momentum and they need to step back in order to see that this is happening."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3145 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_96,
