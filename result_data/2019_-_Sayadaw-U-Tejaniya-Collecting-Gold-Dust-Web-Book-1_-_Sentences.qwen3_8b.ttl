    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 11 ;
    neo:sentence_number 1 ;
    neo:text "I don't remember how long I practiced actively like this but after some time of practicing I could maintain my peacefulness while I was with others."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2420 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2421,
