    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 24 ;
    neo:sentence_number 1 ;
    neo:text "How can we understand the nature of pain if we just stared at it and it disappeared?"^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3489 a neo:Document ;
