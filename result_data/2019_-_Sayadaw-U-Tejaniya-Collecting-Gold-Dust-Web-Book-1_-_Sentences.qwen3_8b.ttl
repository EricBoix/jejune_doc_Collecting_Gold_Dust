    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:h3 "AWARENESS AT WORK"^^xsd:string ;
    neo:id "5801d3b8f1daffbbbd874138b0191d2f"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 5 ;
    neo:text "Although it is difficult in the beginning, any amount of effort you put in brings momentum and that in turn makes it more effortless and continuous in the future."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2686 a neo:Document ;
