    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 11 ;
    neo:sentence_number 6 ;
    neo:text "Everyone around me was drunk and talking loudly but I was very peaceful."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2432 a neo:Document ;
