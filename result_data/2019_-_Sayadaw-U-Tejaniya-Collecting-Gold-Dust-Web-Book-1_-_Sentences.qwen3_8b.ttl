    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "0ea96167f40fbb5aa54e7707bd9d393b"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 5 ;
    neo:text "By meditating, we are growing the qualities of awareness, perseverance, stability of mind, faith, and wisdom."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3141 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_1672,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_311 ;
