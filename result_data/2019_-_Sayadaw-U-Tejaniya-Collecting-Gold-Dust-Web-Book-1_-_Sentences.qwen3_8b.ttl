    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 1 ;
    neo:text "If you reflect on this life alone and add up the amount of time that you have spent trying to be aware, to grow the practice, and wisdom, you will find that it is a small amount of time."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_316 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_317,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_318 ;
