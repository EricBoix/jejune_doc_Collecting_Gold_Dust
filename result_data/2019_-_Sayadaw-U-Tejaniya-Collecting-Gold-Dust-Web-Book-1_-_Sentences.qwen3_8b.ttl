    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 12 ;
    neo:sentence_number 2 ;
    neo:text "Whether they are sense objects or your experience, you need to view them as nature."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3369 a neo:Document ;
