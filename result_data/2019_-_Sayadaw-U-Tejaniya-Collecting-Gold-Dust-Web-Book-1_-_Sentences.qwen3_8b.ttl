    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 19 ;
    neo:sentence_number 1 ;
    neo:text "The suffering feeling reminded me to be mindful and that mindfulness made me feel a bit better each time I was mindful."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_685 a neo:Document ;
