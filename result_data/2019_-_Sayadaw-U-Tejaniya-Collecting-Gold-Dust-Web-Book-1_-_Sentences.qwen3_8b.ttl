    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "2227a3f2e1690c606c95f5798de95b6f"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 17 ;
    neo:sentence_number 2 ;
    neo:text "The monks' kutis were far from each other and it was pitch dark but I knew the land well and there was moonlight so I walked without lighting the flashlight I had with me."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_637 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_49,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_636,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_638 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "9d55197b605cda25b807cd1670f018f0"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 17 ;
    neo:sentence_number 3 ;
    neo:text "As I walked back to my teacher's kuti at one point I just felt like using the flashlight so I flashed it and stopped dead."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_639 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_49,
