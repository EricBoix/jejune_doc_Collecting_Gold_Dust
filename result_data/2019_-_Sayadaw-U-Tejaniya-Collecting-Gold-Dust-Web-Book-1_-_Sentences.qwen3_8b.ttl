    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 4 ;
    neo:text "Meditation involves the things we observe (called objects) and that which is observing (the mind)."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_325 a neo:Document ;
