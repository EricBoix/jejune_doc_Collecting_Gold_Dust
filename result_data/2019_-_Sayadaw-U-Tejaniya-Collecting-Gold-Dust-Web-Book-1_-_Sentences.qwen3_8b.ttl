    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "e162c7dc38489103daeba4d232dd38a2"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 18 ;
    neo:sentence_number 2 ;
    neo:text "I knew how to watch the mind, I knew about the watching mind or awareness of awareness and I could use the six sense objects just fine, and although I often speak to yogis about using questions, I myself initially had none."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_662 a neo:Document ;
