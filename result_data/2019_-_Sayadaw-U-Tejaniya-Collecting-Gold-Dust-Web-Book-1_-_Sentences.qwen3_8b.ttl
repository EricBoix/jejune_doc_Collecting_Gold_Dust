        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_810,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_811 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "2e60cd6d4f57a793ecc259563dfa8422"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 26 ;
    neo:sentence_number 3 ;
    neo:text "I merely listened and did not contribute as I saw neither wisdom nor meaning in adding fuel to their fire."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_81 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_82,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_83,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_84,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_85 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Dear Reader"^^xsd:string ;
    neo:id "15f9982a767eccd8cf9db0f9b4c3c947"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:sentence_number 1 ;
    neo:text "Meditating in daily life means building up these skills with diligence and right inquiry."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_812 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_131,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_813 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "8e8b3ff783bc41047fea51e1294bf506"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 26 ;
    neo:sentence_number 4 ;
    neo:text "The mindfulness became so much keener, aware of everything I said or planned to say and naturally the strength and composure of the mind also improved."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_814 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_131,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_320,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_777,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_815,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_816,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_817 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "0535efa25c2ed0e29597df7364f706d5"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 27 ;
    neo:sentence_number 1 ;
    neo:text "After two years of practicing dedicatedly I began to notice that I had been avoiding unnecessary interactions and I began to challenge myself to go to social functions as a representative of my family and maintain mindfulness, or to go out for dinner with old friends and maintain my mindfulness, composure, or my stand without frustration or rudeness when they tried to get me to join them in drinking alcohol."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_818 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_320,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_819,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_820 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "7e9ce2adaae4669f972775885c0a0352"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 27 ;
    neo:sentence_number 2 ;
    neo:text "I even went for a boxing match and learned a lasting lesson that this was not the place for me any longer."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_821 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_49,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_822 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "11851912fad747dc33f9ccfc6ec991e9"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 28 ;
    neo:sentence_number 1 ;
    neo:text "I tell you this story to say this is possible for you as well."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_823 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_301,
