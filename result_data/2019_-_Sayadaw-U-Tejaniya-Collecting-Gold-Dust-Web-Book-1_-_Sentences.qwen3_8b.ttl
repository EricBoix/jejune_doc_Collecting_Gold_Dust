    neo:paragraph_number 1 ;
    neo:sentence_number 2 ;
    neo:text "Sometimes we may feel like we are being taken advantage of or being taken for granted."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2728 a neo:Document ;
