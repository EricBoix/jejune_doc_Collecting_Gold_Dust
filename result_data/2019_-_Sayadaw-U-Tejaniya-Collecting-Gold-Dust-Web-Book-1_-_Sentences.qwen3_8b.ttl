    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 18 ;
    neo:sentence_number 1 ;
    neo:text "Yogis label the times when they are lost in thought and don't know that they're thinking because they are lost in thoughts as a wandering mind."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3416 a neo:Document ;
