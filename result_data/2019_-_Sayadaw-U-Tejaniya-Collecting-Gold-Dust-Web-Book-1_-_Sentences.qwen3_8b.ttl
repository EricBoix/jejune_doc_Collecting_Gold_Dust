    neo:paragraph_number 2 ;
    neo:sentence_number 2 ;
    neo:text "Sometimes you will have more time to devote to your practice and do it freely and you will know something like, \"Oh the mind is thinking about this so it can do that.\""^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2661 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_18,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2441,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2662,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_311 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:h3 "AWARENESS AT WORK"^^xsd:string ;
    neo:id "552b16fe249e6e188761c5192f079c4e"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 3 ;
    neo:text "When you build the habit of noticing the mind at work then you will notice that awareness just starts popping up because it becomes a habit for the mind to recognize itself doing work."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2663 a neo:Document ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
