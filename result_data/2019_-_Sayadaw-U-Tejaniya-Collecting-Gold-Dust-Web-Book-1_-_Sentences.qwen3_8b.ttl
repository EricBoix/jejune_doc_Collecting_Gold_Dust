    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 28 ;
    neo:sentence_number 6 ;
    neo:text "The only reason we aren't able to bring it into our lives is because we don't know enough yet or aren't practicing enough yet."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_834 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_835,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_836 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "1873378ed8c0752d62a3f0e5dd5764ca"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 29 ;
    neo:sentence_number 1 ;
    neo:text "You may go on formal retreats to develop wholesome minds."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_837 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_315,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_836,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_838 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "466d95d45d3fc357b7085e71732637dd"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 29 ;
    neo:sentence_number 2 ;
    neo:text "But it is very important that you continue meditating outside of retreats because unwholesome minds arise in the absence of wholesome minds."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_839 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_40,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_836 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "dff8e8b65371488f30c8ff87b10e4430"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 29 ;
    neo:sentence_number 3 ;
    neo:text "Right now, as soon as yogis leave a retreat, they have no idea where all the wholesome minds have disappeared!"^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_840 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_320,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_841,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_842 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "4c467fe5adee812f74cbada844c4fde7"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 29 ;
    neo:sentence_number 4 ;
    neo:text "It seems as if wholesome minds just arise on retreat, only to be replaced by unwholesome mind states as soon as a person returns home."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_843 a neo:Document ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
