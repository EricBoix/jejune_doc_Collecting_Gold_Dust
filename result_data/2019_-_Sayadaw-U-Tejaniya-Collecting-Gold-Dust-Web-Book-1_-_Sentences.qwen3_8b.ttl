    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:sentence_number 5 ;
    neo:text "I considered it and realized that it wasn't as much about a division of 50-50 as much as allowing the mind to do its work naturally."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2676 a neo:Document ;
