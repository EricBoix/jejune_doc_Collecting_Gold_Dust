        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_271,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_36 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "2da490dc6e8a475577a035bf015d156e"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 1 ;
    neo:text "You may be finished with a formal retreat for now but remember that the dhamma is everything, so it is everywhere, all the time."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2672 a neo:Document ;
