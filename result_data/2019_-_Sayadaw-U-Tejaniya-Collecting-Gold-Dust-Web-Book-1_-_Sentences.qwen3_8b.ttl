    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 8 ;
    neo:text "When something happens, the mind starts making judgments, sets up parameters, and develops ideas of what's appropriate and boundaries of \"you\" and \"me.\""^^xsd:string .

