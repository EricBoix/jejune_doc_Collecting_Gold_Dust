    neo:paragraph_number 1 ;
    neo:sentence_number 4 ;
    neo:text "Both must be clear in order to have a complete picture of the workings of awareness in the present moment and thus for wisdom to arise."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_1152 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_1153,
