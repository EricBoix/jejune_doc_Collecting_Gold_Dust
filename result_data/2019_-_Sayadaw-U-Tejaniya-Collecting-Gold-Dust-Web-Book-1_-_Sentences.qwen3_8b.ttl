    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 9 ;
    neo:sentence_number 4 ;
    neo:text "If you can use energy in that right way, you can go on practicing the whole day without feeling tired."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3349 a neo:Document ;
