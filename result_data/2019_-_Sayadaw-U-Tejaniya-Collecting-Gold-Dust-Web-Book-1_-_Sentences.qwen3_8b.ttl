    neo:text "Instead we remind ourselves that what is happening, what we're experiencing, and what we're observing is all nature."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3270 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_1757,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_295 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Appendix: Mindfulness in Brief"^^xsd:string ;
