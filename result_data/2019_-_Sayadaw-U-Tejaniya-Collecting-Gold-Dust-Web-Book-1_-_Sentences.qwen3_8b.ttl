    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 1 ;
    neo:text "A yogi has three jobs, and we will cover these in turn: 1) to have right view, 2) to be aware, and finally, 3) to practice continuously."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3258 a neo:Document ;
