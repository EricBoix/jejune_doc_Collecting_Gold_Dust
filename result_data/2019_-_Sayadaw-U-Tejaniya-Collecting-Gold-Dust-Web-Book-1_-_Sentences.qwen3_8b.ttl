    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 20 ;
    neo:sentence_number 4 ;
    neo:text "Sometimes I would make the wrong decisions and had to deal with the fall out of that too."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_715 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_354,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_39,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_693 ;
