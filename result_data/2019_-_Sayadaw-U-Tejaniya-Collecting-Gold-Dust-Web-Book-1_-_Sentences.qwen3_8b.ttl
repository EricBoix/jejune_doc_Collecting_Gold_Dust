    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "06df79708644205ff9ea5e9e5253065d"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 15 ;
    neo:sentence_number 1 ;
    neo:text "When I finally, in my exhausted and suffering mind, decided maybe I should try meditating at home, something I'd never done before then, I went to speak to my teacher."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_574 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_335,
