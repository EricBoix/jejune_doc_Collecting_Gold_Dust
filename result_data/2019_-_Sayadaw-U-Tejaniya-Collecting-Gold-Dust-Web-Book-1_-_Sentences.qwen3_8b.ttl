    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 7 ;
    neo:text "We should remind ourselves that objects will always follow their nature, that they are doing what they are doing, and that they are being seen, heard or experienced."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3274 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_295,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_311,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3275 ;
