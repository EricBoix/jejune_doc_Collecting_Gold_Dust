    neo:paragraph_number 18 ;
    neo:sentence_number 7 ;
    neo:text "I did not begin using other objects until months afterwards."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_675 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_306,
