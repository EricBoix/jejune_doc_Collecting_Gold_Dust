    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 13 ;
    neo:sentence_number 1 ;
    neo:text "It is very easy for defilements to come into our speech when we speak about ourselves, when the \"I\" becomes involved."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2439 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_120,
