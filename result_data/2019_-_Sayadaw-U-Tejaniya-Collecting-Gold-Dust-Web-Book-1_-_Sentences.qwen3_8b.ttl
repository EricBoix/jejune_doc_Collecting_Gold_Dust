    neo:paragraph_number 30 ;
    neo:sentence_number 1 ;
    neo:text "Finally, we all have to live, but we must ask ourselves: Are we truly alive?"^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_853 a neo:Document ;
