    neo:paragraph_number 12 ;
    neo:sentence_number 1 ;
    neo:text "You also need to know how to view these objects that are arising."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3367 a neo:Document ;
