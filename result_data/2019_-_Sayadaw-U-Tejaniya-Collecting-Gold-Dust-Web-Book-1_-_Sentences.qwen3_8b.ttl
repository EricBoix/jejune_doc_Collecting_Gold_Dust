    neo:h2 "A Lighter Approach"^^xsd:string ;
    neo:id "db1826bafceaec2995c2dea6c6cbd9d4"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 4 ;
    neo:text "For me, it was at this point that I really understood the true nature of vipassana meditation and began to believe that it is possible to become enlightened while living life."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2927 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2928,
