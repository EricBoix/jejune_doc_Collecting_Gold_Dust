    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 17 ;
    neo:sentence_number 8 ;
    neo:text "All sorts of resistance follow that idea."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3408 a neo:Document ;
