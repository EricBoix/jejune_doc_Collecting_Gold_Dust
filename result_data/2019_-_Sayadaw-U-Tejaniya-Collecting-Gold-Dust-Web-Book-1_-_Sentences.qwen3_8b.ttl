    neo:paragraph_number 11 ;
    neo:sentence_number 7 ;
    neo:text "This is how I developed confidence in my practice."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2434 a neo:Document ;
