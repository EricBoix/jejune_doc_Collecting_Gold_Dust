    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 18 ;
    neo:sentence_number 1 ;
    neo:text "Of course mindfulness was not continuous when I got home from that \"kick-starter\" retreat."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_658 a neo:Document ;
