    neo:paragraph_number 19 ;
    neo:sentence_number 7 ;
    neo:text "I didn't want to suffer and the temporary peace I got did not satisfy the mind's craving."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_698 a neo:Document ;
