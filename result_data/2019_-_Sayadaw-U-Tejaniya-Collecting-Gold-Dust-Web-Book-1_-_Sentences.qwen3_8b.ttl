    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "83c263b4911ded5119761359a1b7457a"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 20 ;
    neo:sentence_number 2 ;
    neo:text "I often felt unable to make the decisions that had to be made."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_710 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_709,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_711 ;
