    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 17 ;
    neo:sentence_number 9 ;
    neo:text "There is no need to struggle with your thoughts because the thinking mind is never a problem."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3409 a neo:Document ;
