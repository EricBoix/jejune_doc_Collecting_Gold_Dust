    neo:paragraph_number 11 ;
    neo:sentence_number 4 ;
    neo:text "Sometimes I would walk into a bar and meditate."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2427 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_39 ;
