    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 12 ;
    neo:sentence_number 2 ;
    neo:text "Good luck in your endeavors!"^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2243 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2244,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2245 ;
