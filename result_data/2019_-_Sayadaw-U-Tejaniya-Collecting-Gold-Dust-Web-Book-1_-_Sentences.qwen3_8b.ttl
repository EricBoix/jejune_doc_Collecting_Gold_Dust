    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 23 ;
    neo:sentence_number 2 ;
    neo:text "When there is right understanding, when we have true realization into the nature of things, there will be calm in the mind."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3484 a neo:Document ;
