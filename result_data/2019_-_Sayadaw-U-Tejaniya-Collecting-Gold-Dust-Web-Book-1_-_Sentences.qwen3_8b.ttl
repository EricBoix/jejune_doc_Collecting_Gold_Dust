    neo:paragraph_number 1 ;
    neo:sentence_number 3 ;
    neo:text "How do we cultivate these good qualities?"^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3247 a neo:Document ;
