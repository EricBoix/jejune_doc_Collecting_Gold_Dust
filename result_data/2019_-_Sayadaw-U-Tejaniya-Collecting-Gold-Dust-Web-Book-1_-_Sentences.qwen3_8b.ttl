    neo:h2 "A Lighter Approach"^^xsd:string ;
    neo:h3 "USING WISDOM"^^xsd:string ;
    neo:id "e8e5334a03d462a7e2664dbfd074be6b"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 1 ;
    neo:text "Meditators often forget to use their natural wisdom when they meditate at home because they haven't practiced using it."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2929 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_18,
