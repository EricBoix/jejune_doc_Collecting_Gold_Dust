    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "95fed0ae61a2d294ae19b73d9a287cbb"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 18 ;
    neo:sentence_number 4 ;
    neo:text "Fear and anxiety overwhelmed me, and when the feelings were really strong, I would sometimes use the feeling as the object and watch them continuously until the feeling subsided."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_667 a neo:Document ;
