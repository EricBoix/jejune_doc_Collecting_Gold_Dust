    neo:paragraph_number 4 ;
    neo:sentence_number 6 ;
    neo:text "Even drugs couldn't do the job."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_1953 a neo:Document ;
