    neo:paragraph_number 8 ;
    neo:sentence_number 1 ;
    neo:text "I also had a first taste of the importance of the mind after an incident with a bed bug."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_419 a neo:Document ;
