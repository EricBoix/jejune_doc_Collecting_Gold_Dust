    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:h3 "CAUSES AND CONDITIONS"^^xsd:string ;
    neo:id "c0a4c35d826571f3390bdc40ce8cd9b9"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:sentence_number 1 ;
    neo:text "I usually tell yogis to stay away from the storyline, but it can help to see the idea that the story carries."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2247 a neo:Document ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:h3 "CAUSES AND CONDITIONS"^^xsd:string ;
    neo:id "1bf66040415065d2b20d2213839f5721"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:sentence_number 2 ;
    neo:text "The story might be, \"Anne was making a noise and I felt really angry with her\" while the idea behind that might be \"people shouldn't make noise.\""^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2248 a neo:Document ;
