    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:sentence_number 2 ;
    neo:text "Sometimes I say that we need a 60/40 awareness, which means we pay attention 60% to the observing mind and 40% to the object."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3280 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_1310,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_144,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_146,
