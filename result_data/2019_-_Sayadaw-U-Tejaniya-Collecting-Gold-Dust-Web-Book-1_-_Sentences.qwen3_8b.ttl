    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 10 ;
    neo:sentence_number 10 ;
    neo:text "What is the mind aware of?"^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_492 a neo:Document ;
