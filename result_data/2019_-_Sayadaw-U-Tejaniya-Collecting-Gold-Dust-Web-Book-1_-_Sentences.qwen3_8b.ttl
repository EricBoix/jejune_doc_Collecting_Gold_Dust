    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "2eb7b2ca9ef31b52b98f5340471958ad"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 20 ;
    neo:sentence_number 3 ;
    neo:text "Very often, the decisions just had to be made, without regard as to whether they were right or wrong, because my state of mind did not allow me this perspective."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_712 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_39,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_713,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_714 ;
