    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 11 ;
    neo:sentence_number 2 ;
    neo:text "The posture is not important, and is even less so in daily life where you have to go about your business doing things."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_3362 a neo:Document ;
