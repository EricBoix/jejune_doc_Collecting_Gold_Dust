        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2206 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:h3 "CAUSES AND CONDITIONS"^^xsd:string ;
    neo:id "394e3de2032744ec21579320410f51ee"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 3 ;
    neo:text "Then there's individual conditioning, parental influences, and each person's experiences throughout life; there are so many combinations and permutations that everybody has a unique footprint."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2207 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2208,
        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_2209 ;
