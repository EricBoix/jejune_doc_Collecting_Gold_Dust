        ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_75 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "0cd59e33b4731544491c5f834ecbea56"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 15 ;
    neo:sentence_number 3 ;
    neo:text "I accompanied my teacher for a four- to five-day retreat to a monastery about 10 miles out of Bago that he was visiting to give myself a boost."^^xsd:string .

ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_579 a neo:Document ;
    neo:MENTIONS ex:node_4_40b58d44_1cd7_4a1a_b4b0_c6bd00cc8a48_372,
