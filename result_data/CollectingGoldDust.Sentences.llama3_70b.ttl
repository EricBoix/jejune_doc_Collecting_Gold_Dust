    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 1 ;
    neo:text "When you need to be working, just do it fully."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2454 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_120,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_47,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_768 ;
