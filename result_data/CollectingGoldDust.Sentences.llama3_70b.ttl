    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 10 ;
    neo:sentence_number 2 ;
    neo:text "When I was practicing continuously in daily life, I would use feeling as my touchstone."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3059 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_312,
