    neo:paragraph_number 8 ;
    neo:sentence_number 5 ;
    neo:text "I knew I could get it back so I continued meditating but it didn't come back."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_431 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_36,
