    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 2 ;
    neo:text "Some people ask, \"What should I be aware of?\""^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2188 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2189,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_838 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:h3 "SPEAKING MINDFULLY"^^xsd:string ;
    neo:id "abe9265a4c07a07a7bdb1ff49ff2e7db"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 3 ;
    neo:text "and I say, \"Know that you are speaking, notice whatever part of the speaking experience is most obvious to you.\""^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2190 a neo:Document ;
