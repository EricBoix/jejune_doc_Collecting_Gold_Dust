    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 14 ;
    neo:sentence_number 3 ;
    neo:text "At one point I thought I wanted to be a monk for life and told my family and my teacher and they were all happy for me."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_537 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_36,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_538 ;
