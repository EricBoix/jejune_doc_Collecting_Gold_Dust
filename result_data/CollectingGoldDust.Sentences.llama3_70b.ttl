    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:sentence_number 5 ;
    neo:text "Of course, if there is a defilement, we ought to deal with it and not let it carry on unchecked."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2373 a neo:Document ;
