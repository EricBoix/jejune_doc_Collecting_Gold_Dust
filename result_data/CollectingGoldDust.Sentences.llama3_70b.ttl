    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 8 ;
    neo:sentence_number 3 ;
    neo:text "I am aware of this experience."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3046 a neo:Document ;
