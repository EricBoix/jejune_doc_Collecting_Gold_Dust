    neo:paragraph_number 20 ;
    neo:sentence_number 6 ;
    neo:text "Know that and what's happening after that."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3142 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_120,
