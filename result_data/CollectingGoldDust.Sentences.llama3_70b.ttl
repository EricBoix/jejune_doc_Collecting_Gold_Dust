    neo:paragraph_number 8 ;
    neo:sentence_number 6 ;
    neo:text "I tried harder, I walked, I sat, and I still did not sleep."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_434 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_36,
