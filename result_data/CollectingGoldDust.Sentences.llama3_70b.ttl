    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 8 ;
    neo:sentence_number 1 ;
    neo:text "For example, if I am sitting on a rug right now and I'm aware of this rug, this is not considered meditation awareness."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3042 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3041,
