    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 23 ;
    neo:sentence_number 4 ;
    neo:text "The real goal of this meditation is to understand."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3170 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_1029,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_136 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Appendix: Mindfulness in Brief"^^xsd:string ;
    neo:id "f5a62307d3e41ba8ae32722d22007ac6"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 24 ;
    neo:sentence_number 1 ;
    neo:text "How can we understand the nature of pain if we just stared at it and it disappeared?"^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3171 a neo:Document ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
