    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 14 ;
    neo:sentence_number 2 ;
    neo:text "My father had no objections to my going and I mostly did the customary days off during the Burmese New Year."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_534 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_326,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_36,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_535,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_536 ;
