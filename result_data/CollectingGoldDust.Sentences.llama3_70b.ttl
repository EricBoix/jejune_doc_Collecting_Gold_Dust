    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 3 ;
    neo:text "At that point, you need to switch from doing to recognizing."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2871 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_112,
