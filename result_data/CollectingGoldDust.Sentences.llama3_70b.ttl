    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:sentence_number 1 ;
    neo:text "Sayadaw is a strong proponent of applying the Buddha's teachings to daily activities in a monastery, at home, and at work."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_701 a neo:Document ;
