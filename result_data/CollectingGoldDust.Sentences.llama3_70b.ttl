    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:h3 "AWARENESS AT WORK"^^xsd:string ;
    neo:id "55c26836979b3a9c1072ee4fb55e826e"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 4 ;
    neo:text "The operative word is continuously."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2478 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_109,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2407,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_290 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:h3 "AWARENESS AT WORK"^^xsd:string ;
    neo:id "5801d3b8f1daffbbbd874138b0191d2f"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 5 ;
    neo:text "Although it is difficult in the beginning, any amount of effort you put in brings momentum and that in turn makes it more effortless and continuous in the future."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2479 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_71 ;
