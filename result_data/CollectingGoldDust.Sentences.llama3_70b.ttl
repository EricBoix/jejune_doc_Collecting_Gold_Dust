    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 21 ;
    neo:sentence_number 5 ;
    neo:text "You can use any object that is easy for you to be aware of as an anchor to establish mindfulness."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3151 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_1083,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_120,
