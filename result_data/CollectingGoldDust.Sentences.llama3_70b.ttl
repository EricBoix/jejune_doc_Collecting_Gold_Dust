    neo:paragraph_number 15 ;
    neo:sentence_number 1 ;
    neo:text "A concept is just a name given to reality."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3083 a neo:Document ;
