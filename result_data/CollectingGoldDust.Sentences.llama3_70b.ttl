    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 16 ;
    neo:sentence_number 7 ;
    neo:text "Then it dawned on me after he left that I was all alone in that area."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_605 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_606,
