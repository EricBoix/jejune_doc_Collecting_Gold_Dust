    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 5 ;
    neo:text "Getting to this level of awareness requires consistent practice."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2453 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_1149 ;
