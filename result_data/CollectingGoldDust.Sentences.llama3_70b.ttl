    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 1 ;
    neo:text "I was about 13 years old when I started to meditate."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_332 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_317,
