    neo:h2 "Appendix: Mindfulness in Brief"^^xsd:string ;
    neo:id "9a821925b06184c51031bc909df51cdc"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 19 ;
    neo:sentence_number 7 ;
    neo:text "It is natural for the body to become uncomfortable if we sit still for long periods."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3123 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_1029,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_136,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3124 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Appendix: Mindfulness in Brief"^^xsd:string ;
    neo:id "ff730b8c047fc00e9705f44a7b37ab5b"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 19 ;
    neo:sentence_number 8 ;
    neo:text "We should observe pain because we want to understand something about the nature of pain; we don't observe pain in hopes that it will go away."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3125 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3126,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3127 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Appendix: Mindfulness in Brief"^^xsd:string ;
    neo:id "0f5cd78cd463293a2333831a80cf3a8c"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 19 ;
    neo:sentence_number 9 ;
    neo:text "Why do you think your leg hurts when it hurts?"^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3128 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3126,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_803 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Appendix: Mindfulness in Brief"^^xsd:string ;
    neo:id "b14171cbdd0b20de9bd4b7413b4da781"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 19 ;
    neo:sentence_number 10 ;
    neo:text "The simplest answer is that your leg hurts because you have a leg."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3129 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_1079,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3130 ;
