        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_336,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_36 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "e4358bcd53795a75c87c7b23a4c42e51"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 2 ;
    neo:text "I worked with a technique that required energetic, rhythmic breathing and got hooked on the pleasant physical sensation and calm that the experience brought."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_337 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_148,
