    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 20 ;
    neo:sentence_number 4 ;
    neo:text "What do you know first when you get up?"^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3138 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3139,
