    neo:paragraph_number 6 ;
    neo:sentence_number 6 ;
    neo:text "As we do it over and over again, we gain momentum and the process becomes easier."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2213 a neo:Document ;
