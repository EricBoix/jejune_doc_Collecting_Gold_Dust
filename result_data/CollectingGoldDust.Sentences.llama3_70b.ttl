    neo:paragraph_number 2 ;
    neo:sentence_number 1 ;
    neo:text "I want to express my appreciation to all yogis."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_351 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_345,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_352,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_36 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "b216eaac099a79d0b7fdb3b728e9deef"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 7 ;
    neo:text "I was so focused on the mindfulness that anything I noticed about myself became a source of joy: it meant I was mindful!"^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_353 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_345,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_354,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_355,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_36 ;
