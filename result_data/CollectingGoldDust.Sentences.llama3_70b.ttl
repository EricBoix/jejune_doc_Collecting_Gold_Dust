    neo:h2 "Appendix: Mindfulness in Brief"^^xsd:string ;
    neo:id "a9e87cc0728a468abab26d665f7ce6e4"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 26 ;
    neo:sentence_number 2 ;
    neo:text "If you are triggered when you are talking to someone, the fact that you are triggered but are still there, with the person, might trigger other emotions like embarrassment or agitation."^^xsd:string .

