    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:sentence_number 7 ;
    neo:text "It has fueled an eternal curiosity in me to observe and investigate, which of course has led to all sorts of discoveries."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_38 a neo:Document ;
