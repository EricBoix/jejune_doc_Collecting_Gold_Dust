    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 4 ;
    neo:text "Fighting anger with anger gets you more anger, or \"anger-squared.\""^^xsd:string .

