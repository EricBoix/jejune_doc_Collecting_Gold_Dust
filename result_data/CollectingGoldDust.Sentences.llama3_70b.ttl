    neo:paragraph_number 1 ;
    neo:sentence_number 10 ;
    neo:text "After a certain point, the Dhamma will carry you along on its wave."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2990 a neo:Document ;
