    neo:paragraph_number 2 ;
    neo:sentence_number 2 ;
    neo:text "Their questions and difficulties have once again inspired many of the explanations in this book."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_380 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_381,
