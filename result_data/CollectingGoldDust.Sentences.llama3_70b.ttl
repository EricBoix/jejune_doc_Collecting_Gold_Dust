    neo:h2 "Reflect. Learn. Keep Going."^^xsd:string ;
    neo:h3 "HOW TO WORK WITH DIFFICULTIES"^^xsd:string ;
    neo:id "1d2afbcf382ae6fcf1e0f66e57f81197"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 3 ;
    neo:text "Defilements like it when you fight because fighting in itself is a defilement and they like that they have a spy in your camp."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_1821 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_1250 ;
