    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:sentence_number 6 ;
    neo:text "Once you gain some understanding that this process is just happening, the mind will start seeing things more and more from this perspective."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2882 a neo:Document ;
