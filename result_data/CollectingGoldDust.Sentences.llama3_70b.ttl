    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:sentence_number 6 ;
    neo:text "This episode and the success I had in finding the answer was so thrilling that I ran out of the dhamma hall immediately to tell my teacher the answer."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_377 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_343,
