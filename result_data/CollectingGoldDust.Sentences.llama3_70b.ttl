    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 16 ;
    neo:sentence_number 4 ;
    neo:text "He turned the pail up to drink directly from it and drank till all the water was gone!"^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_601 a neo:Document ;
