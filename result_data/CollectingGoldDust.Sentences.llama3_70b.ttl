    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 9 ;
    neo:sentence_number 3 ;
    neo:text "There's no need to focus hard but you do need to use right effort to keep reminding yourself to go continuously."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3052 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_143,
