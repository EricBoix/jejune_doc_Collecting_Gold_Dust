        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3044,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_317,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_36 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Appendix: Mindfulness in Brief"^^xsd:string ;
    neo:id "4f3b26d9f739568064dc990b3bf27ae8"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 8 ;
    neo:sentence_number 2 ;
    neo:text "When I am aware of the process of seeing or feeling that allows me to see and feel and interpret this rug as a rug, this is my experience."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3045 a neo:Document ;
