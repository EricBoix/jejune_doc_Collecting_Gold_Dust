    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "8e8b3ff783bc41047fea51e1294bf506"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 26 ;
    neo:sentence_number 4 ;
    neo:text "The mindfulness became so much keener, aware of everything I said or planned to say and naturally the strength and composure of the mind also improved."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_794 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_36,
