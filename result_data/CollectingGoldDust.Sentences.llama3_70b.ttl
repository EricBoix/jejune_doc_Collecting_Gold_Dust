    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 9 ;
    neo:sentence_number 2 ;
    neo:text "If meditation feels like a responsibility,"^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_220 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_216,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_221 ;
