    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 20 ;
    neo:sentence_number 1 ;
    neo:text "The final, important piece of a yogi's three jobs is to practice continuously."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3134 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_16,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3135,
