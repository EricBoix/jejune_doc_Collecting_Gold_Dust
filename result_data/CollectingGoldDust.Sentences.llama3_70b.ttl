    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 7 ;
    neo:sentence_number 10 ;
    neo:text "That is why I say awareness is when you are aware of the six sense objects as your direct experience."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3040 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3026,
