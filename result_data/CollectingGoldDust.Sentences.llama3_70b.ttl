    neo:paragraph_number 16 ;
    neo:sentence_number 11 ;
    neo:text "And the appearance of the man was not ordinary."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_615 a neo:Document ;
