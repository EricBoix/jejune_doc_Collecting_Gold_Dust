    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 23 ;
    neo:sentence_number 1 ;
    neo:text "The goal of Satipatthana practice is to understand deeply."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3165 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_120,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_1287,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3166,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_336,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_384 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Appendix: Mindfulness in Brief"^^xsd:string ;
    neo:id "43eb6aef190676b2485d7dbc86c329e5"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 23 ;
    neo:sentence_number 2 ;
    neo:text "When there is right understanding, when we have true realization into the nature of things, there will be calm in the mind."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3167 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_1165,
