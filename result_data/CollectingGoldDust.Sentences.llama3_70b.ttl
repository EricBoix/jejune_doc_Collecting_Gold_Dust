    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:sentence_number 1 ;
    neo:text "Of course it is not possible to just switch, to immediately change the paradigm."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2873 a neo:Document ;
