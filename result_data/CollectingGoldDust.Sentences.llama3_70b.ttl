    neo:paragraph_number 9 ;
    neo:sentence_number 5 ;
    neo:text "Try to sustain that awareness for longer periods of time throughout the day."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3055 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_259,
