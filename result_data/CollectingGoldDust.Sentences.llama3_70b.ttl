    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 4 ;
    neo:text "When the dhamma takes over, there is just a doing of what is necessary."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2872 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_958 ;
