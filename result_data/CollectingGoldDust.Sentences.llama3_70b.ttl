    neo:paragraph_number 16 ;
    neo:sentence_number 9 ;
    neo:text "My watch, which I had taken off, was on the edge of the well."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_611 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_604,
