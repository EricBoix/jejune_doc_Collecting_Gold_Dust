    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 20 ;
    neo:sentence_number 2 ;
    neo:text "I often felt unable to make the decisions that had to be made."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_693 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_692,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_694,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_695 ;
