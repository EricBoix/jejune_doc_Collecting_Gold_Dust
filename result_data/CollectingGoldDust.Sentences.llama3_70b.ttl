    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 20 ;
    neo:sentence_number 4 ;
    neo:text "Sometimes I would make the wrong decisions and had to deal with the fall out of that too."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_698 a neo:Document ;
