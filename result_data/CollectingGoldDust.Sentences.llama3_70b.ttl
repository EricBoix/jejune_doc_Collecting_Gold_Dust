    neo:paragraph_number 21 ;
    neo:sentence_number 8 ;
    neo:text "It means that mindfulness is getting better."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3155 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_345,
