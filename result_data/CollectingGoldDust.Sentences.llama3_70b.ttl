    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 8 ;
    neo:sentence_number 5 ;
    neo:text "We are not as interested in the concept of a rug in-as-much as we are in the process of seeing or feeling."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3048 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_120,
