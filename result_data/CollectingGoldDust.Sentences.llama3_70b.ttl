    neo:paragraph_number 14 ;
    neo:sentence_number 4 ;
    neo:text "The instruction in the Satipatthana Sutta is to recognize the experience as it is."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3081 a neo:Document ;
