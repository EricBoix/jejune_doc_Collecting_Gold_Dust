    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 1 ;
    neo:text "We always need to remember the difference between personal exertion and the energy of the dhamma taking over."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2864 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_16,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_239 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Continuing the Work"^^xsd:string ;
    neo:h3 "EFFORTLESS AWARENESS"^^xsd:string ;
    neo:id "49083d9f5e9761ab882a2334cb9cacfc"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 3 ;
    neo:text "When you step back you are able to see that the process of awareness is already happening quite naturally."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2865 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_1020,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_1022,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2180,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2235,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_36,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_37 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Continuing the Work"^^xsd:string ;
    neo:h3 "EFFORTLESS AWARENESS"^^xsd:string ;
    neo:id "768076faff3e5adc9b464a850bd8cac6"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 4 ;
    neo:text "That's why I sometimes ask yogis: Can you notice that you can hear even though you are not listening, that seeing is happening even though you are not trying to look at anything?"^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2866 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_120,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_478 ;
