    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 9 ;
    neo:sentence_number 1 ;
    neo:text "So you are aware and you maintain that awareness."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3050 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_1215,
