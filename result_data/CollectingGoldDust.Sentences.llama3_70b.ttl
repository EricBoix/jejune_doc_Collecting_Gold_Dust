    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 23 ;
    neo:sentence_number 3 ;
    neo:text "This calm state is a by-product of understanding or insight."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3169 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_23,
