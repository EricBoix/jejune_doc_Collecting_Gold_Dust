        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_544,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_83 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:h3 "SPEAKING MINDFULLY"^^xsd:string ;
    neo:id "7dd95df6851e96347c5b345d89a1ff60"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 4 ;
    neo:text "On retreat we practice observing body sensations and feelings, and observing the mind."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2192 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_136,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_478,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_968 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:h3 "SPEAKING MINDFULLY"^^xsd:string ;
    neo:id "da767ced061d56e87c8968042c6b10a6"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 5 ;
    neo:text "All these things are still present when we speak and we want to know which of these catches our attention as we speak."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2193 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2148,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_371 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:h3 "SPEAKING MINDFULLY"^^xsd:string ;
    neo:id "f993657b6049f8ccb63f46504fe266f8"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 6 ;
    neo:text "The biggest trap when speaking is the strong desire to speak, wanting a lot to speak."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2194 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_163,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2195,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_345,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_371 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:h3 "SPEAKING MINDFULLY"^^xsd:string ;
    neo:id "bdf2bf5fbe8fbc26b035efafad9233f2"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 7 ;
    neo:text "A strong desire to speak is greed and mindfulness then goes out the window."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2196 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2081,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2186 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:h3 "SPEAKING MINDFULLY"^^xsd:string ;
    neo:id "0706622fc589a45b2a757d7f326e671e"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:sentence_number 1 ;
    neo:text "We can't practice awareness of speech alone; we have to speak to somebody."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2197 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_1079,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_120,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_1200,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2198,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_345,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_478 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:h3 "SPEAKING MINDFULLY"^^xsd:string ;
    neo:id "43dc5a96231e55148088fb81f5636e42"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:sentence_number 2 ;
    neo:text "We have to pay attention to an outside object, not just our own mind and body, so we lose mindfulness because our attention goes fully outside and then we are no longer attentive internally or to our speech."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2199 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_16,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_478,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_821 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:h3 "SPEAKING MINDFULLY"^^xsd:string ;
    neo:id "6101d5593546c3d0d3a614b408a01433"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:sentence_number 3 ;
    neo:text "We start to think about the other person and look at the other person and then all our attention and our awareness goes outwards and our attention is no longer also directed toward ourselves."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_22 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_23,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_24 ;
