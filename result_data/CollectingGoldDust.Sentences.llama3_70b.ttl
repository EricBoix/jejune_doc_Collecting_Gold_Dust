    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 1 ;
    neo:text "I've noticed that when yogis observe defilements, it is often from a point of view that they are enemies to be fought."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_1817 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_1818 ;
