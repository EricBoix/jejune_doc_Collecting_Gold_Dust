        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2339,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2448,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_47 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:h3 "AWARENESS AT WORK"^^xsd:string ;
    neo:id "a244395fdeb8679fe8bcc6520e48d1fe"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 3 ;
    neo:text "Initially you might not be able to be aware of inside and outside when you are working but try to practice whenever you can to allow momentum to build."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2450 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_16,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2451,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_355 ;
