    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 16 ;
    neo:sentence_number 2 ;
    neo:text "He was large and very dark, his skin almost black, that he must have been in the heat a long time."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_599 a neo:Document ;
