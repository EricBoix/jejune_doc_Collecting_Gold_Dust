    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 15 ;
    neo:sentence_number 5 ;
    neo:text "When I got to the monastery, I spent my time practicing as I already knew well how to."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_569 a neo:Document ;
