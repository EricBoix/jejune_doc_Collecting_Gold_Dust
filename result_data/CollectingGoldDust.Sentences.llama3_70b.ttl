    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 9 ;
    neo:sentence_number 4 ;
    neo:text "If you can use energy in that right way, you can go on practicing the whole day without feeling tired."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3054 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_16,
