    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 21 ;
    neo:sentence_number 6 ;
    neo:text "The anchor just starts the mind off on being mindful and once you are aware of any object for some time, the mind will actually start to know other objects."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3152 a neo:Document ;
