    neo:paragraph_number 10 ;
    neo:sentence_number 8 ;
    neo:text "From then on, my practice changed."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_484 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_115,
