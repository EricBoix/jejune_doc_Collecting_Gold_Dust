    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 22 ;
    neo:sentence_number 1 ;
    neo:text "You are observing everything to understand the nature of this mind- body experience."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3158 a neo:Document ;
