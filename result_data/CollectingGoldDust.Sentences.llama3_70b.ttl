    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 10 ;
    neo:sentence_number 7 ;
    neo:text "I saw the mind and whatever it knew."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_482 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_476,
