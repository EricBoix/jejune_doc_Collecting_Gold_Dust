    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 17 ;
    neo:sentence_number 2 ;
    neo:text "The monks' kutis were far from each other and it was pitch dark but I knew the land well and there was moonlight so I walked without lighting the flashlight I had with me."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_629 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_326,
