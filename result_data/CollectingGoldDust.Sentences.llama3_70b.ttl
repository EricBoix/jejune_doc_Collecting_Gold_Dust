    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 19 ;
    neo:sentence_number 12 ;
    neo:text "That is awareness and right view that we can develop."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3132 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3133,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_47,
