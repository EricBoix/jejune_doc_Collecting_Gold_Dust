    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 15 ;
    neo:sentence_number 3 ;
    neo:text "I accompanied my teacher for a four- to five-day retreat to a monastery about 10 miles out of Bago that he was visiting to give myself a boost."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_567 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_36,
