    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 20 ;
    neo:sentence_number 2 ;
    neo:text "Whatever you do, first be aware of yourself, and then go about your task."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3136 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_23,
