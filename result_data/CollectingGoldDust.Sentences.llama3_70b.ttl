    neo:paragraph_number 3 ;
    neo:sentence_number 6 ;
    neo:text "When the power is right for you, then you see the letters clearly."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2677 a neo:Document ;
