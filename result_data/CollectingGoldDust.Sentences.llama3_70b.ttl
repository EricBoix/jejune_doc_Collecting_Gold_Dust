        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_338,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_339,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_36 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "ee2d03c742498b39d8c7574cf61fe737"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 3 ;
    neo:text "When I told Sayadawgyi about this and that I liked it, he was curious and asked me about my experiences."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_340 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_147,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_341,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_342,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_343,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_65 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "fd8e62b3cc224d50a3fe785d137be61f"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 4 ;
    neo:text "He would tell me stories of other people's special meditation experiences and this would make me want such experiences and motivated me to meditate very diligently."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_344 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_345,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_346,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_347,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_36 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "dbe298ce7a28170bd63c2325a8026573"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 5 ;
    neo:text "I quickly caught on that when I maintained detailed mindfulness throughout the day, the feelings of calm and pleasantness could be sustained so I was zealous in maintaining mindfulness."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_348 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_247,
