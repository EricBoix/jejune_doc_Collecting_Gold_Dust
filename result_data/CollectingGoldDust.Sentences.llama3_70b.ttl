    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "996302366431b6a4ebc2ea62a8f00918"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 8 ;
    neo:text "It never mattered to me even if I discovered an undesirable quality because the point I saw was that I was mindful."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_356 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_148,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_325,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_343 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "e07f1cc8eef1e48a575294d54c48e20f"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:sentence_number 1 ;
    neo:text "Sayadawgyi often asked me why certain things happened when I went to him to describe my experiences."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_357 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_358,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_359,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_36,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_65 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "e697ab740ccde80ffbf36382cb733115"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:sentence_number 2 ;
    neo:text "One episode in particular was when he asked me to find out why the abdomen rises and falls (that was my main object at that time) and I said it was because of the breath."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_360 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_334,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_65 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "9400d144c392357c19d08eb6357ea28b"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:sentence_number 3 ;
    neo:text "Then he asked why there was breathing."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_361 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_36,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_362,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_363 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "11a0c5f42ba4d03203ac026019618905"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:sentence_number 4 ;
    neo:text "I did not know this answer, which prompted a six-day search to find out."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_364 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_115,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_359,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_365,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_366,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_367,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_368,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_369,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_370,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_371,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_372 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "e828b49c88c5ca42f0b9cf0780410b8a"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:sentence_number 5 ;
    neo:text "Every day, at every sit, the question dogged my observation of the breath and I remember on day six when the curious mind thought about why it was breathing and I saw the desire to breathe."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_373 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_326,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_362,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_374,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_375,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_376 ;
