    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 9 ;
    neo:text "Once hooked on these ideas, the mind won't like it when one of these ideas is violated."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2485 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_338,
