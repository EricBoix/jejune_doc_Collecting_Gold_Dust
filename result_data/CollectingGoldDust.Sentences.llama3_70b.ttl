    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 1 ;
    neo:text "I would like yogis, especially for those who have been practicing for years, to get to the point where they realize that without focusing or paying attention, that knowing is happening."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2869 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_109,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_47,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_654,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_94 ;
