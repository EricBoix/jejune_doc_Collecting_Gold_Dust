    neo:id "78e9719481c91d73644f91c74d46fc37"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 2 ;
    neo:text "For example, somebody may have a very hot temper, and that person's conditioning includes certain triggers that sets off their temper."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2085 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2082,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2086,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2087,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_821 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:h3 "CAUSES AND CONDITIONS"^^xsd:string ;
    neo:id "14edd0a7b74ead10a8bd83081e14169c"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 3 ;
    neo:text "If you understand that a person's past conditioning is what is causing them to lose their temper as opposed to believing that they personally have negative intentions towards you, then it becomes easier to see the process and forgive that person."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2089 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_1151,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_1267,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2090,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_821 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:h3 "CAUSES AND CONDITIONS"^^xsd:string ;
    neo:id "1b30382e992bda21cc4025693a95cf0c"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 4 ;
    neo:text "You recognize that because of conditions, the results arise, and it's not the person who's angry, but a set of conditions that has brought about this effect."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2091 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2092,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_879 ;
