    neo:paragraph_number 7 ;
    neo:sentence_number 5 ;
    neo:text "You can be aware of your experience as you are listening to the other person and recognize that you are listening."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2229 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_1200,
