    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 2 ;
    neo:text "Also watch the feelings that accompany this thinking so that you can know when it is becoming too much."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2376 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2377 ;
