    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:sentence_number 4 ;
    neo:text "(Laughter.)"^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2469 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_120,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2470,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_36,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_407 ;
