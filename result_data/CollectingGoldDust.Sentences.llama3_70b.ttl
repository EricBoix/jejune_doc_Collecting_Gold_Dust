    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:sentence_number 2 ;
    neo:text "It is nothing extraordinary."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2177 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_16,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2178,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_262,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_741 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:h3 "SPEAKING MINDFULLY"^^xsd:string ;
    neo:id "b1b1bd2e81931b164fe9a0427ac63bf4"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:sentence_number 3 ;
    neo:text "The Satipatthana Sutta prescribes, \"When silent, be silent with awareness and wisdom, when speaking, speak with awareness and wisdom,\" but few people practice that."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2179 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2148,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2180,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_345 ;
