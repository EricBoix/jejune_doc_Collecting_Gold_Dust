    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 21 ;
    neo:sentence_number 4 ;
    neo:text "These are just a few examples."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3150 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_1083,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_345 ;
