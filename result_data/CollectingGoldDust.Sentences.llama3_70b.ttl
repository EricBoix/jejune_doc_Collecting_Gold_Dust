    neo:paragraph_number 19 ;
    neo:sentence_number 9 ;
    neo:text "This in hindsight was a blessing in disguise!"^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_688 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_36,
