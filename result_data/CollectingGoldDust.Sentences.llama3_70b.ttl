    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:sentence_number 7 ;
    neo:text "While there may be a lot of personal effort in the beginning, it eventually begins to roll on its own momentum, like riding a bike."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2216 a neo:Document ;
