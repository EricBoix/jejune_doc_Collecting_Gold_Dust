    neo:paragraph_number 8 ;
    neo:sentence_number 2 ;
    neo:text "I loved the feeling of calm that came with continuous mindfulness and the attendant samadhi (stability of mind) so much that I would forgo sleep to enjoy this bliss."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_424 a neo:Document ;
