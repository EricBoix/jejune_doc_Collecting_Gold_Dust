    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 6 ;
    neo:text "That's why the Buddha said to practice continuously."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_248 a neo:Document ;
