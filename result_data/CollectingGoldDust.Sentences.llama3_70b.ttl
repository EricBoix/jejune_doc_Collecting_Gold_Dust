    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:sentence_number 8 ;
    neo:text "I liken it to martial arts, where at first you are practicing some simple moves and after a while (you don't know when), you can just use them automatically."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2219 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_120,
