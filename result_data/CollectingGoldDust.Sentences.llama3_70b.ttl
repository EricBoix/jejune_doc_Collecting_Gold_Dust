    neo:paragraph_number 10 ;
    neo:sentence_number 11 ;
    neo:text "This opened up the practice immensely at the center."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_489 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_47,
