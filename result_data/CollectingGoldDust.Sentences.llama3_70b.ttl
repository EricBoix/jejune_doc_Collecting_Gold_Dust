    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:sentence_number 1 ;
    neo:text "I did not invent this idea of cultivating awareness while talking."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2175 a neo:Document ;
