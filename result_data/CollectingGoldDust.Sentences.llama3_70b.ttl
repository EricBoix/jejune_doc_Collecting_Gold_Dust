    neo:paragraph_number 1 ;
    neo:sentence_number 3 ;
    neo:text "Here are some considerations: Can you see your level of effort?"^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2695 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_307 ;
