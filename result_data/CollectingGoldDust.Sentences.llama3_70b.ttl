    neo:paragraph_number 6 ;
    neo:sentence_number 6 ;
    neo:text "Later in the interview I asked her why she was blushing repeatedly while she sat."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2736 a neo:Document ;
