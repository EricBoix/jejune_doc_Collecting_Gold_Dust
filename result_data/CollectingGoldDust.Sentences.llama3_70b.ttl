    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 8 ;
    neo:sentence_number 4 ;
    neo:text "Being aware of only the conceptual part of the experience is not sati."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3047 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2180,
