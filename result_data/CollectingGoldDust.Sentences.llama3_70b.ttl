    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 25 ;
    neo:sentence_number 6 ;
    neo:text "Then you will also know if there is a need to talk."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3186 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_120,
