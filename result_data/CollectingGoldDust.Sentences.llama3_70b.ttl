    neo:paragraph_number 8 ;
    neo:sentence_number 4 ;
    neo:text "Even though this disrupted the blissful feelings, I was unperturbed."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_430 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_36,
