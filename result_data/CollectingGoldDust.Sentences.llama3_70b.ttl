    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:sentence_number 5 ;
    neo:text "There could be another kind of belief, \"I wanted to get to my food and she has slowed that down by jumping the queue.\""^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2496 a neo:Document ;
