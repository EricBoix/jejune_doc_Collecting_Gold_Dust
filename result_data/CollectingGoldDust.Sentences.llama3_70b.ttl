    neo:paragraph_number 2 ;
    neo:sentence_number 4 ;
    neo:text "These are all a part of our experience."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3160 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_1079,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_120,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3161 ;
