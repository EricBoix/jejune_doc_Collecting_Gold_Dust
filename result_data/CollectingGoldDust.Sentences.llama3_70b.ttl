    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 16 ;
    neo:sentence_number 13 ;
    neo:text "I could have been robbed and killed if he had had any ill intentions."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_618 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_36,
