    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 14 ;
    neo:sentence_number 5 ;
    neo:text "My teacher gently tried to persuade me to stay but when my mind was made up there was no changing it."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_540 a neo:Document ;
