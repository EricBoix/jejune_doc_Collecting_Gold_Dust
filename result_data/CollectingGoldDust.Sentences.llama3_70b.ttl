    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 25 ;
    neo:sentence_number 4 ;
    neo:text "You do not want to cut off speech without awareness of what you need to do."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3182 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2195,
