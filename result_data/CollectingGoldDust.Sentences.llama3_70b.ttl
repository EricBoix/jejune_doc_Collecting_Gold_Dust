    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:sentence_number 6 ;
    neo:text "If, on the other hand, it is wholesome, we can encourage it."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2374 a neo:Document ;
