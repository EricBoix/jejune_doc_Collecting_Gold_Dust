        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_94,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_974 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:h3 "AWARENESS AT WORK"^^xsd:string ;
    neo:id "d54366cb464965b6744b371e0f4be07c"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 1 ;
    neo:text "Meditating at work is a skill and by skill, I mean lots of practice!"^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2446 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_120,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2447,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2448 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:h3 "AWARENESS AT WORK"^^xsd:string ;
    neo:id "ca132c076053e3ceedbebaf8876e477c"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 2 ;
    neo:text "Initially, of course, when you pay attention to outside phenomena, you can't concentrate on phenomena inside; when you put your mind inside you can't really be aware of what is happening outside."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2449 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_109,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_1149,
