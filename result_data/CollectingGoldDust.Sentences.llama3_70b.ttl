    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 25 ;
    neo:sentence_number 5 ;
    neo:text "Use some restraint and know, consider and understand before you speak."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3184 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_1681,
