    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 11 ;
    neo:sentence_number 1 ;
    neo:text "At home, the practice was forgotten and I got busy having fun with my friends."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_491 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_36,
