    neo:paragraph_number 21 ;
    neo:sentence_number 9 ;
    neo:text "When the mindfulness is good, it begins to feel like it knows four or five objects simultaneously."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3156 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3157,
