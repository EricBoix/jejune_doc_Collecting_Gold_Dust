    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 16 ;
    neo:sentence_number 10 ;
    neo:text "I knew the area had prisons somewhere."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_613 a neo:Document ;
