    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 20 ;
    neo:sentence_number 3 ;
    neo:text "Very often, the decisions just had to be made, without regard as to whether they were right or wrong, because my state of mind did not allow me this perspective."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_696 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_36,
