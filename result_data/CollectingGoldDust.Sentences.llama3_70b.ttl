        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_689,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_690 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
