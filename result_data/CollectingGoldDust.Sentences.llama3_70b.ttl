    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 20 ;
    neo:sentence_number 7 ;
    neo:text "It's even better when you know all your movements and if you know what is happening in the mind at the same time."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3144 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2282,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3145 ;
