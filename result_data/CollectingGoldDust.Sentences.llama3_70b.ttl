    neo:paragraph_number 2 ;
    neo:sentence_number 5 ;
    neo:text "One yogi realized that the idea of \"one second\" of time was a concept and the past dropped away for him with this understanding."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2445 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_47,
