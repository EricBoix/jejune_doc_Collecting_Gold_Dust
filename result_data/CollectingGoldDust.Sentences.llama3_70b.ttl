    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 5 ;
    neo:text "Can you notice that even though you are not paying attention, your mind already knows things?"^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2867 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2295,
