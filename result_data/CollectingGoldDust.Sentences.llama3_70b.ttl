    neo:paragraph_number 2 ;
    neo:sentence_number 1 ;
    neo:text "When I was younger, I went for long retreats of six to ten months at a time."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_868 a neo:Document ;
