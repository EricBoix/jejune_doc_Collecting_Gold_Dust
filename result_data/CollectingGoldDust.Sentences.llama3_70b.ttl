        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_349,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_350,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_65 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "A Note from the Teacher"^^xsd:string ;
    neo:id "e9a88f7127bfcfc2b602cd6a2f2df2a3"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 6 ;
    neo:text "He also told me something that really stuck with me: be happy when I noticed anything about myself because it meant that I was aware of myself, that I was mindful."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_35 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_36,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_37 ;
