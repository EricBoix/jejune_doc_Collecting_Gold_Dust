    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 5 ;
    neo:text "Allow this to happen."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2460 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_115,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2461,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_51 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:h3 "AWARENESS AT WORK"^^xsd:string ;
    neo:id "f6489fdc76747564f2869d6a4deba988"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:sentence_number 1 ;
    neo:text "A yogi once asked a question about building up continuous practice, \"How much should we do?\""^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2462 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_36 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:h3 "AWARENESS AT WORK"^^xsd:string ;
    neo:id "f30e3afba05b5b050b6b2a35b0aa1ece"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:sentence_number 2 ;
    neo:text "I said, \"Do it 50-50.\""^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2464 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2465,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2466,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2467 ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:h3 "AWARENESS AT WORK"^^xsd:string ;
    neo:id "d90ca141c3c2ea945b5c63f6ed208348"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:sentence_number 3 ;
    neo:text "The yogi was a psychiatrist so he thought a moment about my suggestion and asked, \"How do you measure?\""^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2468 a neo:Document ;
    neo:h1 "COLLECTING GOLD DUST: Nurturing the Dhamma in Daily Living"^^xsd:string ;
