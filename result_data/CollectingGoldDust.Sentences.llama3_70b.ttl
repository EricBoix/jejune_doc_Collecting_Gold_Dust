    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 4 ;
    neo:text "By then, everyone would listen whenever I spoke because what I said was something of value."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2760 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_36,
