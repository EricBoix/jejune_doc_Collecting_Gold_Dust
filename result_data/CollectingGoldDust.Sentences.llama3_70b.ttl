    neo:h2 "Day-to-Day"^^xsd:string ;
    neo:h3 "AWARENESS AT WORK"^^xsd:string ;
    neo:id "39640a68011b1705e6ca8a98a661358c"^^xsd:string ;
    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 8 ;
    neo:text "When something happens, the mind starts making judgments, sets up parameters, and develops ideas of what's appropriate and boundaries of \"you\" and \"me.\""^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2484 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_120,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_1210 ;
