    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 20 ;
    neo:sentence_number 1 ;
    neo:text "I worked at my father's shop, trying to cope with the demands of the business in my state of anxiety, uncertainty, and fear."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_691 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_36,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_692 ;
