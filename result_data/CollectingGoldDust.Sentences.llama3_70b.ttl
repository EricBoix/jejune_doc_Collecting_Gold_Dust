    neo:paragraph_number 7 ;
    neo:sentence_number 9 ;
    neo:text "He may instead refer just to the concept of what has happened where the thought has already processed the whole experience."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3038 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_16,
