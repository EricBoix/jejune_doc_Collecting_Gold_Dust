    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 19 ;
    neo:sentence_number 11 ;
    neo:text "Where there is a body, there will also be physical pain."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3131 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_106,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_16 ;
