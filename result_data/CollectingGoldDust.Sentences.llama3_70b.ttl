    neo:jejune_source_name "2019_-_Sayadaw-U-Tejaniya-Collecting-Gold-Dust-Web-Book-1_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 21 ;
    neo:sentence_number 3 ;
    neo:text "You can use awareness of breathing in and out at the nostrils (anapanasati), rising and falling of the abdomen, or sounds as anchors."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3149 a neo:Document ;
