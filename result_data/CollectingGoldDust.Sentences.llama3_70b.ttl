    neo:paragraph_number 5 ;
    neo:sentence_number 6 ;
    neo:text "The mind has convinced itself of all these strands of thought!"^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2498 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2499,
