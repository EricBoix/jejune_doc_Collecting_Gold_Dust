    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 25 ;
    neo:sentence_number 3 ;
    neo:text "Speaking is all around us in daily life."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3181 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_1200,
