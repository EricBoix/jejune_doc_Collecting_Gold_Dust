    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 9 ;
    neo:sentence_number 2 ;
    neo:text "You do not have to use much energy to be aware."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3051 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_1681,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_921 ;
