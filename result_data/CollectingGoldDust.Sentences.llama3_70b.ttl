    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 10 ;
    neo:sentence_number 1 ;
    neo:text "You can take one object that you know lightly and use that as a grounding object to explore more widely."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3057 a neo:Document ;
