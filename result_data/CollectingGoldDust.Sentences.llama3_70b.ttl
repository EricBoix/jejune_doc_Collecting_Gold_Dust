    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 1 ;
    neo:text "It is best not to observe the thinking mind alone."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2375 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_1348,
