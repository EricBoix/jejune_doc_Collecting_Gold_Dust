    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 16 ;
    neo:sentence_number 14 ;
    neo:text "Again, the thought came to me that I was not ready to die in my current state of mind."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_62 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_32,
