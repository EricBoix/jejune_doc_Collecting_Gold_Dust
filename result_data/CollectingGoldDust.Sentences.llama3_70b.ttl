    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 26 ;
    neo:sentence_number 1 ;
    neo:text "There are many things that can happen while you are talking."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3188 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_1071,
