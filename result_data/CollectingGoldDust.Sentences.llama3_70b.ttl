    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 2 ;
    neo:text "That is already a battle lost."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_1819 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_1820,
        ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_850 ;
