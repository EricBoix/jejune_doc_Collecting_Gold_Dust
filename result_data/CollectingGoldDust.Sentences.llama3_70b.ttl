    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:sentence_number 4 ;
    neo:text "Or different thoughts of fairness might come up."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_2495 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_1181,
