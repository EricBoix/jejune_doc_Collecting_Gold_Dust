    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 21 ;
    neo:sentence_number 2 ;
    neo:text "If you are used to using an anchor, then use that anchor as a starting point."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_3147 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_1854,
