    neo:jejune_source_slug "collecting-gold-dust"^^xsd:string ;
    neo:paragraph_number 15 ;
    neo:sentence_number 4 ;
    neo:text "It was probably my time because I had three insights while meditating at that monastery that gave me some impetus to persevere when I went home."^^xsd:string .

ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_568 a neo:Document ;
    neo:MENTIONS ex:node_4_4b1e9561_d146_4421_8669_7c384dd27495_36,
